{
  "uuid": "53C1CC08-081F-4A71-9C52-CF20966F31B1",
  "name": "ChatGPTBox Gemini List Conversations",
  "steps": [
    {
      "uuid": "53C1CC08-081F-4A71-9C52-CF20966F31BE",
      "type": "script",
      "platforms": 3,
      "isEnabled": true,
      "data": {
        "script": "/* global HTTP, app, draft */\n// Generated by scripts/sync-drafts-engines.mjs. Edit engine-actions.shared.txt.\nconst ACTION = 'list'\nconst BASE_URL = 'http://127.0.0.1:18080'\nconst API_TOKEN = 'PASTE_GATEWAY_API_TOKEN_HERE'\nconst HISTORY_PAGE_SIZE = 20\n// Generated into the four Gemini actions. Version 3 keeps legacy ChatGPT actions\n// from interpreting these engine-run documents as ChatGPT conversation controls.\nconst ENGINE = 'geminiweb'\nconst HEADER = /^<!-- chatgptbox-document:(\\{[^\\n]*\\}) -->\\n?/\nconst originalContent = draft.content || ''\nconst identifier = () =>\n  Date.now().toString(36) +\n  Math.random().toString(36).slice(2).padEnd(12, '0') +\n  Math.random().toString(36).slice(2).padEnd(12, '0')\nconst encode = (value) => JSON.stringify(value).replace(/</g, '\\\\u003c').replace(/>/g, '\\\\u003e')\nconst safeTitle = (value) => String(value || 'Gemini conversation').replace(/[\\r\\n<>]/g, ' ')\nconst userText = (value) =>\n  String(value).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')\nconst clone = (value) => JSON.parse(JSON.stringify(value))\n\nfunction request(path, method = 'GET', data, key) {\n  const response = HTTP.create().request({\n    url: BASE_URL + path,\n    method,\n    headers: { Authorization: 'Bearer ' + API_TOKEN, ...(key ? { 'Idempotency-Key': key } : {}) },\n    ...(data === undefined ? {} : { data, encoding: 'json' }),\n  })\n  const body = response.responseData\n  if (!response.success || response.statusCode >= 400) {\n    const error = new Error(\n      body?.error?.message ||\n        response.error ||\n        'Gateway request could not be confirmed. Keep this note and use Get.',\n    )\n    error.detail = body\n    throw error\n  }\n  if (!body || typeof body !== 'object')\n    throw new Error('The gateway returned an invalid result. Keep this note and use Get.')\n  return body\n}\nfunction readDocument() {\n  const match = originalContent.match(HEADER)\n  if (!match) {\n    const lines = originalContent\n      .trim()\n      .split('\\n')\n      .filter((line) => line.trim())\n    const legacyList =\n      lines.length > 0 &&\n      lines.every((line) =>\n        /^- \\[[ xX]\\].*<!-- chatgptbox-conversation:[A-Za-z0-9-]+ -->\\s*$/.test(line),\n      )\n    if (/^<!-- chatgptbox-document:/.test(originalContent) || legacyList)\n      throw new Error(\n        'Use the matching ChatGPT actions for an old ChatGPT note. Gemini actions preserve it unchanged.',\n      )\n    return {\n      meta: { version: 3, engineId: ENGINE, id: identifier(), kind: 'new' },\n      body: originalContent,\n    }\n  }\n  let meta\n  try {\n    meta = JSON.parse(match[1])\n  } catch {\n    throw new Error('Damaged ChatGPTBox document header. The complete note was kept.')\n  }\n  if (\n    meta.version !== 3 ||\n    meta.engineId !== ENGINE ||\n    !/^[a-z0-9]{16,80}$/.test(meta.id) ||\n    !['new', 'list', 'conversation'].includes(meta.kind)\n  )\n    throw new Error(\n      'This is not a supported Gemini document. Use its matching actions; the complete note was kept.',\n    )\n  return { meta, body: originalContent.slice(match[0].length) }\n}\nfunction marker(meta, name) {\n  return '<!-- chatgptbox-' + meta.id + '-' + name + ' -->'\n}\n// An accidental-edit checksum, not an authentication or secrecy boundary.\nfunction checksum(text) {\n  let first = 2166136261,\n    second = 3339675911\n  for (let index = 0; index < text.length; index++) {\n    const code = text.charCodeAt(index)\n    first = Math.imul(first ^ code, 16777619)\n    second = Math.imul(second ^ code, 2246822519)\n  }\n  return text.length + ':' + (first >>> 0).toString(16) + ':' + (second >>> 0).toString(16)\n}\nfunction pendingText(pending) {\n  return (\n    '## USER\\n\\n' +\n    userText(pending.query) +\n    '\\n\\n## ASSISTANT (pending)\\n\\nUse Gemini Get to collect this exact request.'\n  )\n}\nfunction span(meta, body, name) {\n  const start = marker(meta, name + ':start'),\n    end = marker(meta, name + ':end')\n  if (\n    body.split(start).length !== 2 ||\n    body.split(end).length !== 2 ||\n    body.indexOf(end) < body.indexOf(start)\n  )\n    throw new Error(\n      'Damaged or duplicate Gemini controls. The complete note and original request were kept.',\n    )\n  return {\n    start,\n    end,\n    from: body.indexOf(start) + start.length,\n    to: body.indexOf(end),\n    text: body.slice(body.indexOf(start) + start.length, body.indexOf(end)).replace(/^\\n|\\n$/g, ''),\n  }\n}\nfunction validate(meta, body) {\n  if (meta.kind !== 'conversation') return\n  span(meta, body, 'waiting')\n  span(meta, body, 'history')\n  if (meta.pending) {\n    if (\n      !/^drafts-[a-z0-9]+-[a-z0-9]+$/.test(meta.pending.key) ||\n      !meta.pending.request ||\n      typeof meta.pending.query !== 'string'\n    )\n      throw new Error('The original Gemini request is missing. Keep this note for inspection.')\n    if (span(meta, body, 'pending').text !== pendingText(meta.pending))\n      throw new Error(\n        'The pending text was edited. Keep the complete note and restore that generated block before Get; put new text in Waiting Reply or outside the history block.',\n      )\n  } else if (['pending:start', 'pending:end'].some((name) => body.includes(marker(meta, name))))\n    throw new Error('Conflicting Gemini pending controls. The complete note was kept.')\n}\nfunction assertManagedText(meta, body) {\n  if (\n    meta.kind === 'conversation' &&\n    meta.historyChecksum !== checksum(span(meta, body, 'history').text)\n  )\n    throw new Error(\n      'The generated history was edited. The complete note was kept. Move your notes outside its history markers, or use List/Get in a new note before refreshing.',\n    )\n}\nfunction save(meta, body) {\n  validate(meta, body)\n  if (meta.kind === 'conversation')\n    meta.historyChecksum = checksum(span(meta, body, 'history').text)\n  draft.content = '<!-- chatgptbox-document:' + encode(meta) + ' -->\\n' + body\n  draft.update()\n}\nfunction waitingBlock(meta, value = '') {\n  return (\n    '\\n\\n## Waiting Reply\\n' +\n    marker(meta, 'waiting:start') +\n    '\\n' +\n    value +\n    '\\n' +\n    marker(meta, 'waiting:end') +\n    '\\n'\n  )\n}\nfunction transcript(detail) {\n  if (!Array.isArray(detail.messages))\n    throw new Error('Gemini returned no readable conversation messages.')\n  return detail.messages\n    .map((message) =>\n      message.role === 'user'\n        ? '## USER\\n\\n' + userText(message.content)\n        : '## ASSISTANT' +\n          (message.completed ? '' : ' (incomplete)') +\n          '\\n\\n' +\n          (message.supported === false\n            ? 'This native content is not supported. Inspect the original Gemini conversation.'\n            : message.content || 'No confirmed final text is available.'),\n    )\n    .join('\\n\\n')\n}\nfunction detailFor(meta, cursor) {\n  let ref = meta.conversationRef\n  if (!ref) {\n    if (!meta.nativeConversationId)\n      throw new Error(\n        'No native conversation identity is available. Keep this note and inspect its original run.',\n      )\n    const page = request(\n      '/engines/' +\n        ENGINE +\n        '/conversations?conversationId=' +\n        encodeURIComponent(meta.nativeConversationId),\n    )\n    const matches = page.items?.filter((item) => item.id === meta.nativeConversationId)\n    if (matches?.length !== 1 || !matches[0].conversationRef)\n      throw new Error('The original native Gemini conversation could not be identified.')\n    ref = matches[0].conversationRef\n  }\n  return request(\n    '/engines/' +\n      ENGINE +\n      '/conversations/' +\n      encodeURIComponent(ref) +\n      '?limit=' +\n      HISTORY_PAGE_SIZE +\n      (cursor ? '&cursor=' + encodeURIComponent(cursor) : ''),\n  )\n}\nfunction list(meta, body) {\n  if (meta.kind === 'conversation')\n    throw new Error(\n      'Run Gemini List in a new note; this conversation and any waiting request were kept.',\n    )\n  const continuing = meta.kind === 'list' && !!meta.nextCursor\n  const page = request(\n    '/engines/' +\n      ENGINE +\n      '/conversations?limit=50' +\n      (continuing ? '&cursor=' + encodeURIComponent(meta.nextCursor) : ''),\n  )\n  if (!Array.isArray(page.items))\n    throw new Error('The gateway returned an invalid conversation list.')\n  const items = continuing ? [...(meta.items || [])] : []\n  for (const item of page.items) {\n    if (typeof item.conversationRef !== 'string' || !/^[A-Za-z0-9-]+$/.test(item.conversationRef))\n      throw new Error('Invalid conversation reference.')\n    if (!items.some((old) => old.ref === item.conversationRef))\n      items.push({ ref: item.conversationRef, title: safeTitle(item.title) })\n  }\n  if (items.length > 1000)\n    throw new Error(\n      'This list reached 1,000 conversations. Keep it and open another note for further browsing.',\n    )\n  const next = {\n    version: 3,\n    engineId: ENGINE,\n    id: meta.kind === 'list' ? meta.id : identifier(),\n    kind: 'list',\n    items,\n    nextCursor: page.nextCursor || null,\n  }\n  const rows = items.map(\n    (item) =>\n      '- [ ] ' + item.title + ' <!-- chatgptbox-' + next.id + '-conversation:' + item.ref + ' -->',\n  )\n  save(\n    next,\n    '# Gemini conversations\\n\\n' +\n      (next.nextCursor ? 'Run List again to load more. ' : '') +\n      'Check one conversation, then run Gemini Get.\\n\\n' +\n      rows.join('\\n') +\n      '\\n',\n  )\n  void body\n}\nfunction historyBlock(meta, content) {\n  return marker(meta, 'history:start') + '\\n' + content + '\\n' + marker(meta, 'history:end')\n}\nfunction unsent(meta, body, pending, message) {\n  const current = span(meta, body, 'pending')\n  body =\n    body.slice(0, body.indexOf(current.start)) +\n    '## Unsent request\\n\\n' +\n    userText(pending.query) +\n    '\\n\\n' +\n    userText(message) +\n    body.slice(current.to + current.end.length)\n  meta.lastUnsent = { key: pending.key, message }\n  delete meta.pending\n  save(meta, body)\n}\nfunction get(meta, body, older = false) {\n  validate(meta, body)\n  if (meta.kind === 'list') {\n    const selected = []\n    const seen = new Set()\n    for (const line of body.split('\\n')) {\n      if (!line.includes('<!-- chatgptbox-' + meta.id + '-conversation:')) continue\n      const match = line.match(\n        /^- \\[([ xX])\\] .* <!-- chatgptbox-([a-z0-9]+)-conversation:([A-Za-z0-9-]+) -->$/,\n      )\n      if (\n        !match ||\n        match[2] !== meta.id ||\n        seen.has(match[3]) ||\n        !meta.items?.some((item) => item.ref === match[3])\n      )\n        throw new Error('Damaged Gemini list. Keep the complete note.')\n      seen.add(match[3])\n      if (match[1].toLowerCase() === 'x')\n        selected.push(meta.items.find((item) => item.ref === match[3]))\n    }\n    if (seen.size !== meta.items?.length || selected.length !== 1)\n      throw new Error('Check exactly one Gemini conversation, then run Get.')\n    meta = {\n      version: 3,\n      engineId: ENGINE,\n      id: identifier(),\n      kind: 'conversation',\n      title: selected[0].title,\n      conversationRef: selected[0].ref,\n    }\n    body = '# ' + meta.title + '\\n\\n' + historyBlock(meta, '') + waitingBlock(meta)\n  }\n  if (meta.kind !== 'conversation')\n    throw new Error('Use Gemini List/Get for history, or Gemini Send on an ordinary note.')\n  if (older && meta.pending)\n    throw new Error('Collect the pending request with Gemini Get before loading older messages.')\n  if (meta.pending) {\n    const pending = meta.pending\n    if (!pending.runId) {\n      const operation = request('/operations/' + encodeURIComponent(pending.key))\n      pending.runId = operation.result?.runId || operation.operationId\n      if (!pending.runId)\n        throw new Error(\n          'Submission is still unconfirmed. The original request was kept; no resubmission occurred.',\n        )\n      save(meta, body)\n    }\n    let run = request('/runs/' + encodeURIComponent(pending.runId))\n    if (run.engineId !== ENGINE || run.runId !== pending.runId)\n      throw new Error(\n        'The returned run does not match this Gemini request. The original note was kept.',\n      )\n    if (!run.result && run.resultAvailability === 'recoverable' && run.phase === 'settled') {\n      run = request('/runs/' + encodeURIComponent(pending.runId) + '/recover', 'POST', {})\n      if (run.engineId !== ENGINE || run.runId !== pending.runId)\n        throw new Error(\n          'The recovered run does not match this Gemini request. The original note was kept.',\n        )\n    }\n    if (run.phase === 'settled' && run.outcome === 'completed' && run.result?.content) {\n      if (run.result.version !== 1 || !['safe-html', 'markdown'].includes(run.result.format))\n        throw new Error('Unsupported result format; the original run was kept.')\n      const current = span(meta, body, 'pending')\n      body =\n        body.slice(0, body.indexOf(current.start)) +\n        '## USER\\n\\n' +\n        userText(pending.query) +\n        '\\n\\n## ASSISTANT\\n\\n' +\n        run.result.content +\n        body.slice(current.to + current.end.length)\n      meta.conversationRef = run.conversationRef || null\n      meta.revision = run.conversationRevision || null\n      meta.nativeConversationId = run.result.metadata?.conversationId || meta.nativeConversationId\n      meta.serverHead = run.result.metadata?.serverTurnId || null\n      delete meta.pending\n      save(meta, body)\n      app.displaySuccessMessage('Gemini answer collected. Waiting Reply was preserved.')\n    } else if (run.phase === 'settled' && run.submission === 'not_attempted') {\n      unsent(meta, body, pending, run.error?.message || 'The request was not submitted.')\n      throw new Error(\n        'Gemini did not submit this request. Its text was retained above; edit Waiting Reply before another explicit Send.',\n      )\n    } else {\n      save(meta, body)\n      app.displaySuccessMessage(\n        'Still waiting or unconfirmed. Use Get again; no new question was sent.',\n      )\n    }\n    return\n  }\n  if (older && !meta.historyCursor) {\n    app.displaySuccessMessage('All available Gemini turns in this conversation have been loaded.')\n    return\n  }\n  const detail = detailFor(meta, older ? meta.historyCursor : undefined)\n  if (older && meta.serverHead && detail.serverHead !== meta.serverHead)\n    throw new Error(\n      'The native conversation changed. Use Gemini Get to refresh it before loading older turns.',\n    )\n  meta.conversationRef = detail.conversationRef\n  meta.revision = detail.conversationRevision\n  meta.nativeConversationId = detail.conversationId\n  meta.serverHead = detail.serverHead\n  meta.historyCursor = detail.nextCursor || null\n  if (older) {\n    const current = span(meta, body, 'history')\n    save(\n      meta,\n      body.slice(0, current.from) +\n        '\\n' +\n        transcript(detail) +\n        '\\n\\n' +\n        current.text +\n        '\\n' +\n        body.slice(current.to),\n    )\n  } else {\n    const current = span(meta, body, 'history')\n    save(\n      meta,\n      body.slice(0, current.from) + '\\n' + transcript(detail) + '\\n' + body.slice(current.to),\n    )\n  }\n  if (meta.historyCursor)\n    app.displaySuccessMessage('More historical turns are available with Gemini Load Older Turns.')\n}\nfunction send(meta, body) {\n  if (meta.kind === 'list')\n    throw new Error(\n      'Open the checked conversation with Gemini Get before sending. Lists are never submitted.',\n    )\n  validate(meta, body)\n  if (meta.pending) return get(meta, body)\n  const query = meta.kind === 'new' ? body.trim() : span(meta, body, 'waiting').text.trim()\n  if (!query) return get(meta, body)\n  if (query.length > 50000)\n    throw new Error('Gemini accepts up to 50,000 characters. The note was kept.')\n  const continuing =\n    meta.kind === 'conversation' && !!(meta.conversationRef || meta.nativeConversationId)\n  if (continuing && (!meta.conversationRef || !Number.isInteger(meta.revision))) {\n    const detail = detailFor(meta)\n    if (meta.serverHead && detail.serverHead !== meta.serverHead)\n      throw new Error('The native conversation changed. Use Get to inspect it before sending.')\n    meta.conversationRef = detail.conversationRef\n    meta.revision = detail.conversationRevision\n  }\n  const payload = {\n    contractVersion: 1,\n    operation: continuing ? 'conversation.append' : 'generation.start',\n    input: { prompt: query },\n  }\n  if (continuing)\n    payload.conversation = { ref: meta.conversationRef, expectedRevision: meta.revision }\n  const key = 'drafts-' + Date.now().toString(36) + '-' + identifier()\n  const pending = { key, query, request: clone(payload), createdAt: Date.now(), runId: null }\n  if (meta.kind === 'new') {\n    meta.kind = 'conversation'\n    meta.title = 'Gemini conversation'\n    body = '# Gemini conversation\\n\\n' + historyBlock(meta, '') + waitingBlock(meta)\n  } else {\n    const current = span(meta, body, 'waiting')\n    body = body.slice(0, current.from) + '\\n\\n' + body.slice(current.to)\n  }\n  const insertionAt = span(meta, body, 'history').to\n  body =\n    body.slice(0, insertionAt) +\n    '\\n\\n' +\n    marker(meta, 'pending:start') +\n    '\\n' +\n    pendingText(pending) +\n    '\\n' +\n    marker(meta, 'pending:end') +\n    '\\n' +\n    body.slice(insertionAt)\n  meta.pending = pending\n  save(meta, body) // Complete original request is durable BEFORE the HTTP write.\n  try {\n    const receipt = request('/engines/' + ENGINE + '/runs', 'POST', pending.request, key)\n    if (receipt.engineId !== ENGINE || typeof receipt.runId !== 'string')\n      throw new Error('The run receipt was invalid. Keep the original request and use Get.')\n    pending.runId = receipt.runId\n    save(meta, body)\n    app.displaySuccessMessage(\n      'Gemini request registered. Use Get; registration is not a final answer.',\n    )\n  } catch (error) {\n    if (\n      error.detail?.error?.submission === 'not_attempted' ||\n      error.detail?.error?.dispatched === false\n    ) {\n      unsent(meta, body, pending, error.message)\n    }\n    throw error\n  }\n}\ntry {\n  const { meta, body } = readDocument()\n  validate(meta, body)\n  assertManagedText(meta, body)\n  if (ACTION === 'list') list(meta, body)\n  else if (ACTION === 'get') get(meta, body)\n  else if (ACTION === 'send') send(meta, body)\n  else if (ACTION === 'older') get(meta, body, true)\n  else throw new Error('Unknown Gemini action.')\n} catch (error) {\n  app.displayErrorMessage(error.message || String(error))\n  throw error\n}\n",
        "allowAsync": "false"
      }
    }
  ],
  "shouldConfirm": false,
  "disposition": 0,
  "groupDisposition": 0,
  "logLevel": 1,
  "notificationType": 1,
  "tintColor": "green",
  "keyUseIcon": true,
  "icon": "list",
  "visibility": 480,
  "assignTags": []
}
