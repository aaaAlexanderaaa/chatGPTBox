{
  "uuid": "8D0ADAC3-0126-4BDA-9447-2323E89C4D98",
  "name": "ChatGPTBox More",
  "steps": [
    {
      "uuid": "8D0ADAC3-0126-4BDA-9447-2323E89C4D9F",
      "type": "script",
      "platforms": 3,
      "isEnabled": true,
      "data": {
        "script": "/* global HTTP, app, draft, Prompt, FileManager, HTMLPreview, context */\n// Generated by scripts/sync-drafts-engines.mjs. Maintain scripts/drafts/.\nconst ACTION = 'more'\nfunction chatgpt_photos(draft, settings) {\n  // BEGIN CONTROL DOCUMENT\n  /* eslint-disable no-unused-vars */\n  // Generated into every action. The header authenticates structure, not content secrecy.\n  // Model text and user questions never supply control metadata or pending anchors.\n  const CONTROL_HEADER_RE = /^<!-- chatgptbox-document:(\\{[^\\n]*\\}) -->\\n?/\n  const CONTROL_JSON_VALUES = new Set()\n  const CONTROL = openControlDocument(draft.content || '')\n  if (CONTROL.migrated) {\n    delete CONTROL.migrated\n    saveControlDocument()\n  }\n\n  function controlFailure() {\n    const message =\n      'This note has ambiguous or damaged ChatGPTBox controls. Automatic processing stopped. Keep the complete note and its send IDs; update all actions together and inspect the original conversation from a fresh List/Get note before trying again.'\n    app.displayErrorMessage(message)\n    throw new Error(message)\n  }\n  function controlJson(value) {\n    const text = JSON.stringify(value).replace(/</g, '\\\\u003c').replace(/>/g, '\\\\u003e')\n    CONTROL_JSON_VALUES.add(text)\n    return text\n  }\n  function controlText(value) {\n    return value.replace(/chatgptbox-/g, 'chatgptbox-' + CONTROL.id + '-')\n  }\n  function controlRegex(value) {\n    return new RegExp(\n      value.source.replace(/chatgptbox-/g, 'chatgptbox-' + CONTROL.id + '-'),\n      value.flags,\n    )\n  }\n  function controlComments(content, id) {\n    return content.match(new RegExp('<!-- chatgptbox-' + id + '-[^\\\\n]*? -->', 'g')) || []\n  }\n  function assertUniqueControls(comments, list) {\n    const counts = {}\n    let textOperations = 0,\n      photoOperation = false,\n      pendingMessage = false\n    for (const comment of comments) {\n      const match = comment.match(\n        /^<!-- chatgptbox-(?:[a-z0-9]{16,80}-)?(waiting-reply:start|waiting-reply:end|photos:|photo-operation:|new-operation:|photo-status:start|photo-status:end|conversation:)(.*?) -->$/,\n      )\n      if (!match) controlFailure()\n      const name = match[1],\n        value = match[2]\n      if (name === 'waiting-reply:end' || name.startsWith('photo-status:')) {\n        if (value !== '') controlFailure()\n      } else if (name === 'conversation:') {\n        if (!/^[A-Za-z0-9-]+$/.test(value)) controlFailure()\n      } else {\n        let json = value\n        if (name === 'new-operation:') {\n          const operation = value.match(/^drafts-[a-z0-9]+-[a-z0-9]+(?: (\\{.*\\}))?$/)\n          if (!operation) controlFailure()\n          json = operation[1] || '{}'\n        }\n        let metadata\n        try {\n          metadata = JSON.parse(json)\n        } catch {\n          controlFailure()\n        }\n        if (!metadata || typeof metadata !== 'object' || Array.isArray(metadata)) controlFailure()\n        if (name === 'new-operation:') textOperations += 1\n        if (name === 'photo-operation:') photoOperation = true\n        if (name === 'waiting-reply:start') {\n          if (\n            Object.prototype.hasOwnProperty.call(metadata, 'operationId') &&\n            (typeof metadata.operationId !== 'string' || !metadata.operationId.trim())\n          )\n            controlFailure()\n          if (metadata.operationId && metadata.pendingMessageId) controlFailure()\n          if (metadata.operationId) textOperations += 1\n          else if (metadata.pendingMessageId || metadata.pendingQuery || metadata.pendingSentAt)\n            pendingMessage = true\n        }\n      }\n      if (list && name === 'conversation:') continue\n      counts[name] = (counts[name] || 0) + 1\n      if (counts[name] > 1) controlFailure()\n    }\n    if (!!counts['waiting-reply:start'] !== !!counts['waiting-reply:end']) controlFailure()\n    if (!!counts['photo-status:start'] !== !!counts['photo-status:end']) controlFailure()\n    if (textOperations > 1 || (photoOperation && (textOperations || pendingMessage)))\n      controlFailure()\n  }\n  function openControlDocument(content) {\n    const match = content.match(CONTROL_HEADER_RE)\n    if (match) {\n      let value\n      try {\n        value = JSON.parse(match[1])\n      } catch {\n        controlFailure()\n      }\n      if (\n        value.version !== 2 ||\n        !/^[a-z0-9]{16,80}$/.test(value.id) ||\n        !Array.isArray(value.controls)\n      )\n        controlFailure()\n      const body = content.slice(match[0].length)\n      const comments = controlComments(body, value.id)\n      const openers = body.match(new RegExp('<!-- chatgptbox-' + value.id + '-', 'g')) || []\n      if (openers.length !== comments.length) controlFailure()\n      assertUniqueControls(comments, value.kind === 'list')\n      if (controlJson(comments) !== controlJson(value.controls)) controlFailure()\n      return value\n    }\n    if (/<!-- chatgptbox-document:|<!-- chatgptbox-[a-z0-9]{16,80}-/.test(content)) controlFailure()\n    const legacy = content.match(/<!-- chatgptbox-[^\\n]*? -->/g) || []\n    if ((content.match(/<!-- chatgptbox-/g) || []).length !== legacy.length) controlFailure()\n    const list =\n      legacy.length > 0 &&\n      legacy.every((item) => /^<!-- chatgptbox-conversation:[A-Za-z0-9-]+ -->$/.test(item)) &&\n      content\n        .trim()\n        .split('\\n')\n        .every((line) =>\n          /^- \\[[ x]\\].*<!-- chatgptbox-conversation:[A-Za-z0-9-]+ -->\\s*$/.test(line),\n        )\n    assertUniqueControls(legacy, list)\n    // A bare old operation/photo marker could be a quoted example. Only a\n    // recognizable old conversation or task list can own legacy controls.\n    if (legacy.length && !list && !legacy.some((item) => item.includes('waiting-reply:start')))\n      controlFailure()\n    let fence = null\n    for (const line of content.split('\\n')) {\n      const edge = line.match(/^\\s{0,3}(`{3,}|~{3,})/)\n      if (edge) {\n        if (/<!-- chatgptbox-/.test(line)) controlFailure()\n        if (!fence) fence = edge[1]\n        else if (edge[1][0] === fence[0] && edge[1].length >= fence.length) fence = null\n      } else if (fence && /<!-- chatgptbox-/.test(line)) controlFailure()\n    }\n    if (\n      legacy.some((item) => item.includes('waiting-reply:start')) &&\n      (!/^# [^\\n]+\\n+Conversation ID:\\s*[A-Za-z0-9-]+\\s*\\n/.test(content) ||\n        !/^## Waiting Reply[ \\t]*\\n+<!-- chatgptbox-waiting-reply:start /m.test(content) ||\n        content.indexOf('<!-- chatgptbox-waiting-reply:start') <\n          content.indexOf('## Waiting Reply'))\n    )\n      controlFailure()\n    const headerId = content.match(/^Conversation ID:\\s*([A-Za-z0-9-]+)\\s*$/m)\n    const waiting = content.match(/<!-- chatgptbox-waiting-reply:start (\\{.*\\}) -->/)\n    if (waiting) {\n      let metadata\n      try {\n        metadata = JSON.parse(waiting[1])\n      } catch {\n        controlFailure()\n      }\n      if (headerId && metadata.conversationId !== headerId[1]) controlFailure()\n    }\n    if (legacy.length && !list) {\n      const endMarker = '<!-- chatgptbox-waiting-reply:end -->'\n      const end = content.indexOf(endMarker)\n      for (const comment of legacy) {\n        if (comment.includes('waiting-reply:')) continue\n        if (\n          content.indexOf(comment) < end ||\n          !/^<!-- chatgptbox-(?:photos:|photo-operation:|photo-status:)/.test(comment)\n        )\n          controlFailure()\n      }\n      // In original conversation notes these generated blocks follow Waiting\n      // Reply. Transcript examples and arbitrary trailing prose cannot own them.\n      const tail = content\n        .slice(end + endMarker.length)\n        .replace(\n          /<!-- chatgptbox-photo-status:start -->\\nPhoto send: [^\\n]*\\n<!-- chatgptbox-photo-status:end -->/g,\n          '',\n        )\n        .replace(/<!-- chatgptbox-(?:photos:|photo-operation:)\\{[^\\n]*\\} -->/g, '')\n      if (tail.trim()) controlFailure()\n    }\n    const id =\n      Date.now().toString(36) +\n      Math.random().toString(36).slice(2) +\n      Math.random().toString(36).slice(2)\n    // Only unique legacy structural controls migrate. Preserve operation identity/payload.\n    draft.content = content.replace(/<!-- chatgptbox-/g, '<!-- chatgptbox-' + id + '-')\n    return {\n      version: 2,\n      id,\n      kind: list ? 'list' : waiting || headerId ? 'conversation' : 'note',\n      conversationId: headerId?.[1] || null,\n      controls: controlComments(draft.content, id),\n      migrated: legacy.length > 0,\n    }\n  }\n  function plainNoteContent(content) {\n    return content.replace(CONTROL_HEADER_RE, '')\n  }\n  function saveControlDocument() {\n    const body = plainNoteContent(draft.content || '')\n    const comments = controlComments(body, CONTROL.id)\n    assertUniqueControls(comments, CONTROL.kind === 'list')\n    for (const comment of comments) {\n      const json = comment.match(/(\\{.*\\}) -->$/)?.[1]\n      if (json && !CONTROL_JSON_VALUES.has(json) && !CONTROL.controls.includes(comment))\n        controlFailure()\n    }\n    CONTROL.controls = comments\n    if (comments.some((item) => item.includes('-waiting-reply:start ')))\n      CONTROL.kind = 'conversation'\n    draft.content = '<!-- chatgptbox-document:' + controlJson(CONTROL) + ' -->\\n' + body\n    draft.update()\n  }\n  function assertOperationAge(operationId) {\n    const match =\n      typeof operationId === 'string' && operationId.match(/^drafts-([a-z0-9]+)-[a-z0-9]+$/)\n    const createdAt = match ? parseInt(match[1], 36) : NaN\n    if (\n      !Number.isFinite(createdAt) ||\n      Date.now() - createdAt >= 7 * 24 * 60 * 60 * 1000 ||\n      createdAt > Date.now() + 60000\n    )\n      throw new Error(\n        'This send is outside the known recovery window. Its ID was kept. Inspect the original conversation; do not resend with a new ID.',\n      )\n  }\n  /* eslint-enable no-unused-vars */\n  // END CONTROL DOCUMENT\n  const BASE_URL = settings.baseUrl\n  const API_TOKEN = settings.apiToken\n  const MODEL_OVERRIDE = settings.modelOverride\n  const WAITING_REPLY_START_RE = controlRegex(/<!-- chatgptbox-waiting-reply:start (\\{.*\\}) -->/)\n  const WAITING_REPLY_END = controlText('<!-- chatgptbox-waiting-reply:end -->')\n  const PENDING_ANSWER_TEXT = '_Waiting for ChatGPT. Run the Get action to collect the answer._'\n  // BEGIN PHOTO PICKER\n  const PHOTO_PICKER_HTML =\n    \"<!DOCTYPE html>\\n<html lang=\\\"zh-CN\\\">\\n  <head>\\n    <meta charset=\\\"utf-8\\\" />\\n    <meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\" />\\n    <meta\\n      http-equiv=\\\"Content-Security-Policy\\\"\\n      content=\\\"default-src 'none'; img-src blob: data:; style-src 'unsafe-inline'; script-src 'unsafe-inline'\\\"\\n    />\\n    <title>添加餐食照片</title>\\n    <style>\\n      html {\\n        color-scheme: light dark;\\n        font: 17px system-ui;\\n      }\\n      body {\\n        max-width: 640px;\\n        margin: auto;\\n        padding: 24px;\\n      }\\n      h1 {\\n        font-size: 24px;\\n      }\\n      p {\\n        line-height: 1.6;\\n      }\\n      input,\\n      button {\\n        font: inherit;\\n      }\\n      button {\\n        padding: 12px 18px;\\n        margin: 8px 6px 0 0;\\n        border-radius: 10px;\\n        border: 1px solid #888;\\n      }\\n      #photos {\\n        display: flex;\\n        flex-wrap: wrap;\\n        gap: 12px;\\n        margin: 20px 0;\\n      }\\n      img {\\n        width: 140px;\\n        height: 140px;\\n        object-fit: cover;\\n        border-radius: 12px;\\n      }\\n      #error {\\n        color: #c33;\\n      }\\n      button:disabled {\\n        opacity: 0.4;\\n      }\\n    </style>\\n  </head>\\n  <body>\\n    <h1>添加餐食照片</h1>\\n    <p>选择最多 4 张照片。照片会缩小后保存到本机，发送分析请运行 Send。</p>\\n    <input id=\\\"files\\\" type=\\\"file\\\" accept=\\\"image/*\\\" multiple />\\n    <div id=\\\"photos\\\"></div>\\n    <p id=\\\"error\\\" role=\\\"alert\\\"></p>\\n    <button id=\\\"add\\\" disabled>添加照片</button><button id=\\\"cancel\\\">取消</button>\\n    <script>\\n      let images = []\\n      let selection = 0\\n      document.getElementById('files').addEventListener('change', async (event) => {\\n        const add = document.getElementById('add'),\\n          error = document.getElementById('error'),\\n          photos = document.getElementById('photos')\\n        add.disabled = true\\n        error.textContent = ''\\n        photos.replaceChildren()\\n        images = []\\n        const current = ++selection,\\n          captured = []\\n        const files = Array.from(event.target.files || [])\\n        if (files.length > 4) {\\n          error.textContent = '最多选择 4 张照片。'\\n          return\\n        }\\n        try {\\n          for (const file of files) {\\n            if (file.size > 32 * 1024 * 1024) throw new Error('照片过大，请先缩小后再选择。')\\n            const url = URL.createObjectURL(file),\\n              img = new Image()\\n            try {\\n              await new Promise((resolve, reject) => {\\n                img.onload = resolve\\n                img.onerror = () => reject(new Error('无法读取照片，请使用 JPEG、PNG 或 WebP。'))\\n                img.src = url\\n              })\\n              if (current !== selection) return\\n              const scale = Math.min(1, 1600 / Math.max(img.naturalWidth, img.naturalHeight))\\n              const canvas = document.createElement('canvas')\\n              canvas.width = Math.max(1, Math.round(img.naturalWidth * scale))\\n              canvas.height = Math.max(1, Math.round(img.naturalHeight * scale))\\n              const ctx = canvas.getContext('2d')\\n              ctx.fillStyle = '#fff'\\n              ctx.fillRect(0, 0, canvas.width, canvas.height)\\n              ctx.drawImage(img, 0, 0, canvas.width, canvas.height)\\n              const dataUrl = canvas.toDataURL('image/jpeg', 0.85)\\n              if (dataUrl.length > 11184812) throw new Error('照片压缩后仍超过 8 MiB。')\\n              captured.push({ name: file.name.replace(/\\\\.[^.]+$/, '') + '.jpg', data_url: dataUrl })\\n              const thumbnail = document.createElement('img')\\n              thumbnail.src = dataUrl\\n              thumbnail.alt = file.name\\n              photos.appendChild(thumbnail)\\n            } finally {\\n              URL.revokeObjectURL(url)\\n            }\\n          }\\n          if (current === selection) {\\n            images = captured\\n            add.disabled = !images.length\\n          }\\n        } catch (err) {\\n          if (current === selection) {\\n            error.textContent = err.message\\n            images = []\\n          }\\n        }\\n      })\\n      document.getElementById('add').addEventListener('click', () => {\\n        if (!images.length) return\\n        Drafts.send('chatgptboxPhotos', images)\\n        Drafts.continue()\\n      })\\n      document.getElementById('cancel').addEventListener('click', () => Drafts.cancel())\\n    </script>\\n  </body>\\n</html>\"\n  // END PHOTO PICKER\n  function fail(message) {\n    app.displayErrorMessage(message)\n    throw new Error(message)\n  }\n  function requestJson(url, method, body) {\n    const response = HTTP.create().request({\n      url,\n      method,\n      encoding: 'json',\n      data: body,\n      headers: { Authorization: 'Bearer ' + API_TOKEN, 'Content-Type': 'application/json' },\n    })\n    if (!response.success || response.statusCode >= 400)\n      fail(\n        response.responseData?.error?.message ||\n          response.error ||\n          'Photo upload failed; the photo files were kept. Run More → 添加照片 or Send to retry.',\n      )\n    return response.responseData || {}\n  }\n  function findWaitingReply(content) {\n    const match = content.match(WAITING_REPLY_START_RE)\n    if (!match) return null\n    const start = content.indexOf(match[0]) + match[0].length,\n      end = content.indexOf(WAITING_REPLY_END, start)\n    if (end < 0) fail('Waiting reply block is incomplete')\n    return { metadata: JSON.parse(match[1]), query: content.slice(start, end).trim() }\n  }\n  // BEGIN PHOTO HELPERS\n  /* eslint-disable no-unused-vars */\n  const PHOTO_METADATA_RE = controlRegex(/<!-- chatgptbox-photos:(\\{.*\\}) -->/)\n  const PHOTO_OPERATION_RE = controlRegex(/<!-- chatgptbox-photo-operation:(\\{.*\\}) -->/)\n  const PHOTO_STATUS_RE = controlRegex(\n    /<!-- chatgptbox-photo-status:start -->[\\s\\S]*?<!-- chatgptbox-photo-status:end -->\\n?/g,\n  )\n\n  function readPhotoMetadata(content) {\n    const match = content.match(PHOTO_METADATA_RE)\n    return match ? JSON.parse(match[1]) : { images: [], pendingPhotos: [], projectId: null }\n  }\n\n  function writePhotoMetadata(metadata) {\n    const marker = controlText('<!-- chatgptbox-photos:') + controlJson(metadata) + ' -->'\n    draft.content = PHOTO_METADATA_RE.test(draft.content || '')\n      ? draft.content.replace(PHOTO_METADATA_RE, () => marker)\n      : (draft.content || '').trimEnd() + '\\n\\n' + marker + '\\n'\n    saveControlDocument()\n  }\n\n  function readPhotoOperation(content) {\n    const match = content.match(PHOTO_OPERATION_RE)\n    return match ? JSON.parse(match[1]) : null\n  }\n\n  function photoPrompt(content, waitingReply) {\n    return waitingReply\n      ? waitingReply.query\n      : content\n          .replace(PHOTO_METADATA_RE, '')\n          .replace(PHOTO_OPERATION_RE, '')\n          .replace(PHOTO_STATUS_RE, '')\n          .replace(CONTROL_HEADER_RE, '')\n          .trim()\n  }\n\n  function stagePhotoFiles(metadata) {\n    const pending = metadata.pendingPhotos || []\n    // Drafts extends Date.parse and may return null for ISO timestamps with milliseconds.\n    const expired = (metadata.images || []).filter((image) => {\n      const expiresAt = new Date(image.expiresAt).getTime()\n      return !Number.isFinite(expiresAt) || expiresAt <= Date.now()\n    })\n    if (!pending.length && !expired.length) return metadata\n    const fm = FileManager.createLocal()\n    for (const photo of expired) {\n      const image = fm.readJSON(photo.path)\n      if (!image)\n        fail('The photo expired and its local copy is unavailable. Attach it again before sending.')\n      const info = requestJson(BASE_URL + '/chatgpt/attachments', 'POST', image)\n      if (info.id !== photo.id) fail('The saved photo changed. Attach it again before sending.')\n      metadata.images = metadata.images.map((item) =>\n        item.id === photo.id ? { ...info, path: photo.path } : item,\n      )\n      writePhotoMetadata(metadata)\n    }\n    for (const photo of [...pending]) {\n      const image = fm.readJSON(photo.path)\n      if (!image)\n        fail(\n          'Photo file is unavailable on this device. Return to the device where it was attached, or attach the photo again.',\n        )\n      const info = requestJson(BASE_URL + '/chatgpt/attachments', 'POST', image)\n      if (!info.id) fail('Gateway returned no photo ID')\n      metadata.images = [...(metadata.images || []), { ...info, path: photo.path }]\n      metadata.pendingPhotos = metadata.pendingPhotos.filter((item) => item.path !== photo.path)\n      writePhotoMetadata(metadata)\n    }\n    return metadata\n  }\n\n  function photoStatus(status) {\n    const names = {\n      preparing: 'Preparing photos',\n      uploading: 'Uploading photos to ChatGPT',\n      sending: 'Sending message',\n      accepted: 'Waiting for ChatGPT',\n      failed: 'Photo send failed before submission; run Send to retry',\n      interrupted: 'Preparation interrupted; run Send to continue',\n      ambiguous:\n        'Submission could not be confirmed; inspect the original conversation before sending again',\n    }\n    const label = names[status.phase] || 'Checking send status'\n    const line =\n      'Photo send: ' +\n      label +\n      (status.error ? ' (' + status.error.replace(/[\\r\\n]/g, ' ') + ')' : '') +\n      '\\n'\n    draft.content =\n      (draft.content || '').replace(PHOTO_STATUS_RE, '').trimEnd() +\n      '\\n\\n' +\n      controlText('<!-- chatgptbox-photo-status:start -->\\n') +\n      line +\n      controlText('<!-- chatgptbox-photo-status:end -->\\n')\n    saveControlDocument()\n    if (['failed', 'ambiguous'].includes(status.phase)) app.displayErrorMessage(label)\n    else app.displaySuccessMessage(label)\n  }\n\n  function finishPhotoOperation(status, job) {\n    const receipt = status.result\n    if (!receipt || !receipt.conversationId || !receipt.messageId) return false\n    const currentContent = draft.content || ''\n    const currentReply = findWaitingReply(currentContent)\n    const edited = photoPrompt(currentContent, currentReply)\n    const metadata = readPhotoMetadata(currentContent)\n    const unsent = edited && edited !== job.request.query ? edited : ''\n    const images = metadata.images || []\n    const summary = images\n      .filter((image) => job.request.attachments.includes(image.id))\n      .map((image) => '_Photo: ' + String(image.name || 'photo').replace(/[\\r\\n]/g, ' ') + '_')\n      .join('\\n')\n    if (currentReply) {\n      const match = currentContent.match(WAITING_REPLY_START_RE)\n      const start = currentContent.indexOf(match[0]) + match[0].length\n      const end = currentContent.indexOf(WAITING_REPLY_END, start)\n      draft.content =\n        currentContent.slice(0, start) + '\\n' + job.request.query + '\\n' + currentContent.slice(end)\n    } else {\n      draft.content =\n        controlText('# Conversation\\n\\n## Waiting Reply\\n\\n<!-- chatgptbox-waiting-reply:start ') +\n        controlJson({ conversationId: receipt.conversationId }) +\n        ' -->\\n' +\n        job.request.query +\n        controlText('\\n<!-- chatgptbox-waiting-reply:end -->\\n')\n    }\n    const match = draft.content.match(WAITING_REPLY_START_RE)\n    const waitingMetadata = JSON.parse(match[1])\n    delete waitingMetadata.operationId\n    delete waitingMetadata.operationRequest\n    waitingMetadata.conversationId = receipt.conversationId\n    waitingMetadata.defaultModel = receipt.defaultModel || waitingMetadata.defaultModel || null\n    waitingMetadata.pendingMessageId = receipt.messageId\n    waitingMetadata.pendingQuery = job.request.query\n    waitingMetadata.pendingSentAt = receipt.createdAt || new Date().toISOString()\n    const afterStart = draft.content.indexOf(match[0]) + match[0].length\n    const blockEnd = draft.content.indexOf(WAITING_REPLY_END, afterStart)\n    const heading = draft.content.lastIndexOf('## Waiting Reply', draft.content.indexOf(match[0]))\n    const prefix = draft.content\n      .slice(0, heading >= 0 ? heading : draft.content.indexOf(match[0]))\n      .trimEnd()\n    draft.content =\n      prefix +\n      '\\n\\n### USER\\n\\n' +\n      job.request.query +\n      (summary ? '\\n\\n' + summary : '') +\n      '\\n\\n### ASSISTANT (pending)\\n\\n' +\n      PENDING_ANSWER_TEXT +\n      controlText('\\n\\n## Waiting Reply\\n\\n<!-- chatgptbox-waiting-reply:start ') +\n      controlJson(waitingMetadata) +\n      ' -->\\n' +\n      unsent +\n      controlText('\\n<!-- chatgptbox-waiting-reply:end -->\\n') +\n      draft.content.slice(blockEnd + WAITING_REPLY_END.length)\n    draft.content =\n      draft.content\n        .replace(PHOTO_OPERATION_RE, '')\n        .replace(PHOTO_STATUS_RE, '')\n        .replace(PHOTO_METADATA_RE, '')\n        .trimEnd() + '\\n'\n    metadata.images = images.filter((image) => !job.request.attachments.includes(image.id))\n    metadata.projectId = receipt.projectId || metadata.projectId || null\n    writePhotoMetadata(metadata)\n    return true\n  }\n\n  function sendPhotoOperation(content, waitingReply) {\n    let job = readPhotoOperation(content)\n    if (!job) {\n      if (\n        waitingReply &&\n        (waitingReply.metadata.pendingMessageId ||\n          waitingReply.metadata.pendingQuery ||\n          waitingReply.metadata.pendingSentAt ||\n          waitingReply.metadata.operationRequest?.query)\n      )\n        fail(\n          'The previous turn is still pending. Your next question and photos were kept; run Get before sending them.',\n        )\n      const metadata = stagePhotoFiles(readPhotoMetadata(content))\n      const query = photoPrompt(content, waitingReply) || '请分析这些图片，标明不确定的地方。'\n      const conversationId = waitingReply && waitingReply.metadata.conversationId\n      const id =\n        'drafts-photo-' + Date.now().toString(36) + '-' + Math.random().toString(36).slice(2)\n      job = {\n        id,\n        createdAt: new Date().toISOString(),\n        path:\n          '/chatgpt/conversations' +\n          (conversationId ? '/' + encodeURIComponent(conversationId) + '/messages' : ''),\n        request: {\n          query,\n          attachments: (metadata.images || []).map((image) => image.id),\n          async: true,\n          ...(metadata.projectId ? { project_id: metadata.projectId } : {}),\n          ...(MODEL_OVERRIDE ? { model: MODEL_OVERRIDE } : {}),\n        },\n      }\n      draft.content =\n        (draft.content || '').trimEnd() +\n        controlText('\\n\\n<!-- chatgptbox-photo-operation:') +\n        controlJson(job) +\n        ' -->\\n'\n      saveControlDocument()\n    }\n    stagePhotoFiles(readPhotoMetadata(draft.content || ''))\n    const createdAt = typeof job.createdAt === 'string' ? new Date(job.createdAt).getTime() : NaN\n    if (!Number.isFinite(createdAt))\n      fail(\n        'The saved send time is invalid. Run Get or inspect the original conversation; its send ID was kept.',\n      )\n    if (Date.now() - createdAt >= 7 * 24 * 60 * 60 * 1000)\n      fail(\n        'This send is older than the gateway recovery window. Inspect the original conversation; its send ID was kept.',\n      )\n    const status = requestJson(BASE_URL + job.path, 'POST', job.request, job.id)\n    if (!finishPhotoOperation(status, job)) photoStatus(status)\n  }\n\n  function getPhotoOperation(content, includeThinking = false) {\n    const job = readPhotoOperation(content)\n    if (!job) return true\n    const status = requestJson(\n      BASE_URL + '/chatgpt/operations/' + encodeURIComponent(job.id),\n      'GET',\n    )\n    if (status.phase === 'accepted') return finishPhotoOperation(status, job)\n    // A lost acknowledgement does not erase a submitted turn. Only the gateway's\n    // message ID can confirm this send; matching an older question by text cannot.\n    const target =\n      typeof job.path === 'string' &&\n      job.path.match(/^\\/chatgpt\\/conversations\\/([^/?#]+)\\/messages$/)\n    if (\n      status.phase === 'ambiguous' &&\n      target &&\n      typeof status.operationId === 'string' &&\n      status.operationId.trim()\n    ) {\n      const conversationId = decodeURIComponent(target[1])\n      const messageId = status.operationId\n      const conversation = requestJson(\n        BASE_URL +\n          '/chatgpt/conversations/' +\n          encodeURIComponent(conversationId) +\n          '?force_refresh=true&think=' +\n          String(includeThinking) +\n          '&user_message_id=' +\n          encodeURIComponent(messageId),\n        'GET',\n      )\n      const found =\n        conversation.conversationId === conversationId &&\n        Array.isArray(conversation.messages) &&\n        conversation.messages.some(\n          (message) => message.role === 'user' && message.messageId === messageId,\n        )\n      if (\n        found &&\n        finishPhotoOperation(\n          {\n            result: {\n              conversationId,\n              messageId,\n              createdAt: job.createdAt,\n              defaultModel: conversation.defaultModel,\n              projectId: job.request.project_id,\n            },\n          },\n          job,\n        )\n      )\n        return { conversation }\n    }\n    photoStatus(status)\n    return false\n  }\n  /* eslint-enable no-unused-vars */\n  // END PHOTO HELPERS\n\n  try {\n    if (readPhotoOperation(draft.content || ''))\n      fail('A photo send is already in progress. Run Get before changing its attachments.')\n    const existingReply = findWaitingReply(draft.content || '')\n    if (\n      existingReply?.metadata.operationId ||\n      existingReply?.metadata.pendingMessageId ||\n      controlRegex(/<!-- chatgptbox-new-operation:/).test(draft.content || '')\n    )\n      fail(\n        'The previous send is still pending. Run Get before attaching photos to the next message.',\n      )\n    let metadata = readPhotoMetadata(draft.content || '')\n    if (!(metadata.pendingPhotos || []).length) {\n      if ((metadata.images || []).length >= 4)\n        fail('This message already has 4 photos. Send them before attaching more.')\n      if (HTMLPreview.create().show(PHOTO_PICKER_HTML)) {\n        const photos = context.previewValues.chatgptboxPhotos\n        if (!Array.isArray(photos) || !photos.length)\n          fail('Choose photos and use the Add Photos button.')\n        if (photos.length + (metadata.images || []).length > 4)\n          fail('At most 4 photos can be attached to a message.')\n        const fm = FileManager.createLocal()\n        fm.createDirectory('ChatGPTBox Photos', '/')\n        if (!(metadata.images || []).length) metadata.capturedAt = new Date().toISOString()\n        for (const [index, photo] of photos.entries()) {\n          const file =\n            '/ChatGPTBox Photos/' +\n            Date.now().toString(36) +\n            '-' +\n            Math.random().toString(36).slice(2) +\n            '-' +\n            index +\n            '.json'\n          if (!fm.writeJSON(file, photo))\n            fail('Could not save the photo: ' + (fm.lastError || 'local storage unavailable'))\n          metadata.pendingPhotos = [\n            ...(metadata.pendingPhotos || []),\n            { path: file, name: photo.name },\n          ]\n          writePhotoMetadata(metadata)\n        }\n      } else return\n    }\n    const waiting = findWaitingReply(draft.content || '')\n    const prompt =\n      '记录时间：' +\n      (metadata.capturedAt || new Date().toISOString()) +\n      '\\n请根据照片记录这一餐：识别食物，估计份量、热量和主要营养的范围，说明看不出的油、糖、酱料等不确定因素，并给出简短的饮食建议。'\n    if (waiting && !waiting.query) {\n      const match = draft.content.match(WAITING_REPLY_START_RE)\n      const end = draft.content.indexOf(\n        WAITING_REPLY_END,\n        draft.content.indexOf(match[0]) + match[0].length,\n      )\n      draft.content = draft.content.slice(0, end) + prompt + '\\n' + draft.content.slice(end)\n      saveControlDocument()\n    } else if (!waiting && !photoPrompt(draft.content || '', null)) {\n      draft.content = prompt + '\\n\\n' + draft.content\n      saveControlDocument()\n    }\n    metadata = stagePhotoFiles(metadata)\n    app.displaySuccessMessage('Photos attached. Run Send to ask ChatGPT.')\n  } catch (error) {\n    app.displayErrorMessage(error.message || String(error))\n    throw error\n  }\n}\nfunction chatgpt_project(draft, settings) {\n  // BEGIN CONTROL DOCUMENT\n  /* eslint-disable no-unused-vars */\n  // Generated into every action. The header authenticates structure, not content secrecy.\n  // Model text and user questions never supply control metadata or pending anchors.\n  const CONTROL_HEADER_RE = /^<!-- chatgptbox-document:(\\{[^\\n]*\\}) -->\\n?/\n  const CONTROL_JSON_VALUES = new Set()\n  const CONTROL = openControlDocument(draft.content || '')\n  if (CONTROL.migrated) {\n    delete CONTROL.migrated\n    saveControlDocument()\n  }\n\n  function controlFailure() {\n    const message =\n      'This note has ambiguous or damaged ChatGPTBox controls. Automatic processing stopped. Keep the complete note and its send IDs; update all actions together and inspect the original conversation from a fresh List/Get note before trying again.'\n    app.displayErrorMessage(message)\n    throw new Error(message)\n  }\n  function controlJson(value) {\n    const text = JSON.stringify(value).replace(/</g, '\\\\u003c').replace(/>/g, '\\\\u003e')\n    CONTROL_JSON_VALUES.add(text)\n    return text\n  }\n  function controlText(value) {\n    return value.replace(/chatgptbox-/g, 'chatgptbox-' + CONTROL.id + '-')\n  }\n  function controlRegex(value) {\n    return new RegExp(\n      value.source.replace(/chatgptbox-/g, 'chatgptbox-' + CONTROL.id + '-'),\n      value.flags,\n    )\n  }\n  function controlComments(content, id) {\n    return content.match(new RegExp('<!-- chatgptbox-' + id + '-[^\\\\n]*? -->', 'g')) || []\n  }\n  function assertUniqueControls(comments, list) {\n    const counts = {}\n    let textOperations = 0,\n      photoOperation = false,\n      pendingMessage = false\n    for (const comment of comments) {\n      const match = comment.match(\n        /^<!-- chatgptbox-(?:[a-z0-9]{16,80}-)?(waiting-reply:start|waiting-reply:end|photos:|photo-operation:|new-operation:|photo-status:start|photo-status:end|conversation:)(.*?) -->$/,\n      )\n      if (!match) controlFailure()\n      const name = match[1],\n        value = match[2]\n      if (name === 'waiting-reply:end' || name.startsWith('photo-status:')) {\n        if (value !== '') controlFailure()\n      } else if (name === 'conversation:') {\n        if (!/^[A-Za-z0-9-]+$/.test(value)) controlFailure()\n      } else {\n        let json = value\n        if (name === 'new-operation:') {\n          const operation = value.match(/^drafts-[a-z0-9]+-[a-z0-9]+(?: (\\{.*\\}))?$/)\n          if (!operation) controlFailure()\n          json = operation[1] || '{}'\n        }\n        let metadata\n        try {\n          metadata = JSON.parse(json)\n        } catch {\n          controlFailure()\n        }\n        if (!metadata || typeof metadata !== 'object' || Array.isArray(metadata)) controlFailure()\n        if (name === 'new-operation:') textOperations += 1\n        if (name === 'photo-operation:') photoOperation = true\n        if (name === 'waiting-reply:start') {\n          if (\n            Object.prototype.hasOwnProperty.call(metadata, 'operationId') &&\n            (typeof metadata.operationId !== 'string' || !metadata.operationId.trim())\n          )\n            controlFailure()\n          if (metadata.operationId && metadata.pendingMessageId) controlFailure()\n          if (metadata.operationId) textOperations += 1\n          else if (metadata.pendingMessageId || metadata.pendingQuery || metadata.pendingSentAt)\n            pendingMessage = true\n        }\n      }\n      if (list && name === 'conversation:') continue\n      counts[name] = (counts[name] || 0) + 1\n      if (counts[name] > 1) controlFailure()\n    }\n    if (!!counts['waiting-reply:start'] !== !!counts['waiting-reply:end']) controlFailure()\n    if (!!counts['photo-status:start'] !== !!counts['photo-status:end']) controlFailure()\n    if (textOperations > 1 || (photoOperation && (textOperations || pendingMessage)))\n      controlFailure()\n  }\n  function openControlDocument(content) {\n    const match = content.match(CONTROL_HEADER_RE)\n    if (match) {\n      let value\n      try {\n        value = JSON.parse(match[1])\n      } catch {\n        controlFailure()\n      }\n      if (\n        value.version !== 2 ||\n        !/^[a-z0-9]{16,80}$/.test(value.id) ||\n        !Array.isArray(value.controls)\n      )\n        controlFailure()\n      const body = content.slice(match[0].length)\n      const comments = controlComments(body, value.id)\n      const openers = body.match(new RegExp('<!-- chatgptbox-' + value.id + '-', 'g')) || []\n      if (openers.length !== comments.length) controlFailure()\n      assertUniqueControls(comments, value.kind === 'list')\n      if (controlJson(comments) !== controlJson(value.controls)) controlFailure()\n      return value\n    }\n    if (/<!-- chatgptbox-document:|<!-- chatgptbox-[a-z0-9]{16,80}-/.test(content)) controlFailure()\n    const legacy = content.match(/<!-- chatgptbox-[^\\n]*? -->/g) || []\n    if ((content.match(/<!-- chatgptbox-/g) || []).length !== legacy.length) controlFailure()\n    const list =\n      legacy.length > 0 &&\n      legacy.every((item) => /^<!-- chatgptbox-conversation:[A-Za-z0-9-]+ -->$/.test(item)) &&\n      content\n        .trim()\n        .split('\\n')\n        .every((line) =>\n          /^- \\[[ x]\\].*<!-- chatgptbox-conversation:[A-Za-z0-9-]+ -->\\s*$/.test(line),\n        )\n    assertUniqueControls(legacy, list)\n    // A bare old operation/photo marker could be a quoted example. Only a\n    // recognizable old conversation or task list can own legacy controls.\n    if (legacy.length && !list && !legacy.some((item) => item.includes('waiting-reply:start')))\n      controlFailure()\n    let fence = null\n    for (const line of content.split('\\n')) {\n      const edge = line.match(/^\\s{0,3}(`{3,}|~{3,})/)\n      if (edge) {\n        if (/<!-- chatgptbox-/.test(line)) controlFailure()\n        if (!fence) fence = edge[1]\n        else if (edge[1][0] === fence[0] && edge[1].length >= fence.length) fence = null\n      } else if (fence && /<!-- chatgptbox-/.test(line)) controlFailure()\n    }\n    if (\n      legacy.some((item) => item.includes('waiting-reply:start')) &&\n      (!/^# [^\\n]+\\n+Conversation ID:\\s*[A-Za-z0-9-]+\\s*\\n/.test(content) ||\n        !/^## Waiting Reply[ \\t]*\\n+<!-- chatgptbox-waiting-reply:start /m.test(content) ||\n        content.indexOf('<!-- chatgptbox-waiting-reply:start') <\n          content.indexOf('## Waiting Reply'))\n    )\n      controlFailure()\n    const headerId = content.match(/^Conversation ID:\\s*([A-Za-z0-9-]+)\\s*$/m)\n    const waiting = content.match(/<!-- chatgptbox-waiting-reply:start (\\{.*\\}) -->/)\n    if (waiting) {\n      let metadata\n      try {\n        metadata = JSON.parse(waiting[1])\n      } catch {\n        controlFailure()\n      }\n      if (headerId && metadata.conversationId !== headerId[1]) controlFailure()\n    }\n    if (legacy.length && !list) {\n      const endMarker = '<!-- chatgptbox-waiting-reply:end -->'\n      const end = content.indexOf(endMarker)\n      for (const comment of legacy) {\n        if (comment.includes('waiting-reply:')) continue\n        if (\n          content.indexOf(comment) < end ||\n          !/^<!-- chatgptbox-(?:photos:|photo-operation:|photo-status:)/.test(comment)\n        )\n          controlFailure()\n      }\n      // In original conversation notes these generated blocks follow Waiting\n      // Reply. Transcript examples and arbitrary trailing prose cannot own them.\n      const tail = content\n        .slice(end + endMarker.length)\n        .replace(\n          /<!-- chatgptbox-photo-status:start -->\\nPhoto send: [^\\n]*\\n<!-- chatgptbox-photo-status:end -->/g,\n          '',\n        )\n        .replace(/<!-- chatgptbox-(?:photos:|photo-operation:)\\{[^\\n]*\\} -->/g, '')\n      if (tail.trim()) controlFailure()\n    }\n    const id =\n      Date.now().toString(36) +\n      Math.random().toString(36).slice(2) +\n      Math.random().toString(36).slice(2)\n    // Only unique legacy structural controls migrate. Preserve operation identity/payload.\n    draft.content = content.replace(/<!-- chatgptbox-/g, '<!-- chatgptbox-' + id + '-')\n    return {\n      version: 2,\n      id,\n      kind: list ? 'list' : waiting || headerId ? 'conversation' : 'note',\n      conversationId: headerId?.[1] || null,\n      controls: controlComments(draft.content, id),\n      migrated: legacy.length > 0,\n    }\n  }\n  function plainNoteContent(content) {\n    return content.replace(CONTROL_HEADER_RE, '')\n  }\n  function saveControlDocument() {\n    const body = plainNoteContent(draft.content || '')\n    const comments = controlComments(body, CONTROL.id)\n    assertUniqueControls(comments, CONTROL.kind === 'list')\n    for (const comment of comments) {\n      const json = comment.match(/(\\{.*\\}) -->$/)?.[1]\n      if (json && !CONTROL_JSON_VALUES.has(json) && !CONTROL.controls.includes(comment))\n        controlFailure()\n    }\n    CONTROL.controls = comments\n    if (comments.some((item) => item.includes('-waiting-reply:start ')))\n      CONTROL.kind = 'conversation'\n    draft.content = '<!-- chatgptbox-document:' + controlJson(CONTROL) + ' -->\\n' + body\n    draft.update()\n  }\n  function assertOperationAge(operationId) {\n    const match =\n      typeof operationId === 'string' && operationId.match(/^drafts-([a-z0-9]+)-[a-z0-9]+$/)\n    const createdAt = match ? parseInt(match[1], 36) : NaN\n    if (\n      !Number.isFinite(createdAt) ||\n      Date.now() - createdAt >= 7 * 24 * 60 * 60 * 1000 ||\n      createdAt > Date.now() + 60000\n    )\n      throw new Error(\n        'This send is outside the known recovery window. Its ID was kept. Inspect the original conversation; do not resend with a new ID.',\n      )\n  }\n  /* eslint-enable no-unused-vars */\n  // END CONTROL DOCUMENT\n  const BASE_URL = settings.baseUrl\n  const API_TOKEN = settings.apiToken\n  const PHOTO_METADATA_RE = controlRegex(/<!-- chatgptbox-photos:(\\{.*\\}) -->/)\n  try {\n    if (\n      controlRegex(/<!-- chatgptbox-(?:waiting-reply:start|photo-operation:|new-operation:)/).test(\n        draft.content || '',\n      )\n    )\n      throw new Error(\n        'Choose a Project on a new draft before its first send. An existing conversation keeps its current Project.',\n      )\n    const projects = [{ id: null, name: '不使用 Project' }]\n    let cursor,\n      pages = 0\n    const seen = new Set()\n    do {\n      const response = HTTP.create().request({\n        url:\n          BASE_URL + '/chatgpt/projects' + (cursor ? '?cursor=' + encodeURIComponent(cursor) : ''),\n        method: 'GET',\n        headers: { Authorization: 'Bearer ' + API_TOKEN },\n      })\n      if (!response.success || response.statusCode >= 400)\n        throw new Error(\n          response.responseData?.error?.message || response.error || 'Could not read Projects',\n        )\n      for (const project of response.responseData.projects || []) {\n        if (!seen.has(project.id)) {\n          seen.add(project.id)\n          projects.push(project)\n        }\n      }\n      cursor = response.responseData.cursor\n      pages++\n    } while (cursor && pages < 10)\n    if (cursor)\n      throw new Error('Project list is too large. Select a Project by its ID in the API request.')\n    const match = (draft.content || '').match(PHOTO_METADATA_RE)\n    const metadata = match ? JSON.parse(match[1]) : { images: [], pendingPhotos: [] }\n    const selected = Math.max(\n      0,\n      projects.findIndex((project) => project.id === metadata.projectId),\n    )\n    const prompt = Prompt.create()\n    prompt.title = '选择 ChatGPT Project'\n    prompt.addPicker('project', 'Project', [projects.map((project) => project.name)], [selected])\n    prompt.addButton('保存')\n    if (prompt.show()) {\n      const project = projects[prompt.fieldValues.project[0]]\n      metadata.projectId = project.id\n      metadata.projectName = project.name\n      const marker = controlText('<!-- chatgptbox-photos:') + controlJson(metadata) + ' -->'\n      draft.content = match\n        ? draft.content.replace(PHOTO_METADATA_RE, () => marker)\n        : (draft.content || '').trimEnd() + '\\n\\n' + marker + '\\n'\n      saveControlDocument()\n      app.displaySuccessMessage('Project: ' + project.name)\n    }\n  } catch (error) {\n    app.displayErrorMessage(error.message || String(error))\n    throw error\n  }\n}\nfunction runChatGPT(draft, settings, operation) {\n  if (operation === 'photos') return chatgpt_photos(draft, settings)\n  if (operation === 'project') return chatgpt_project(draft, settings)\n  throw new Error('Unsupported ChatGPT operation')\n}\nfunction runGemini(draft, settings, ACTION) {\n  const BASE_URL = settings.baseUrl\n  const API_TOKEN = settings.apiToken\n  const HISTORY_PAGE_SIZE = 20\n  // Inserted into the isolated Gemini adapter in each common action. Version 3\n  // retains existing engine-run identities and the original note validation.\n  const ENGINE = 'geminiweb'\n  const HEADER = /^<!-- chatgptbox-document:(\\{[^\\n]*\\}) -->\\n?/\n  const originalContent = draft.content || ''\n  const identifier = () =>\n    Date.now().toString(36) +\n    Math.random().toString(36).slice(2).padEnd(12, '0') +\n    Math.random().toString(36).slice(2).padEnd(12, '0')\n  const encode = (value) => JSON.stringify(value).replace(/</g, '\\\\u003c').replace(/>/g, '\\\\u003e')\n  const safeTitle = (value) => String(value || 'Gemini conversation').replace(/[\\r\\n<>]/g, ' ')\n  const userText = (value) =>\n    String(value).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')\n  const clone = (value) => JSON.parse(JSON.stringify(value))\n\n  function request(path, method = 'GET', data, key) {\n    const response = HTTP.create().request({\n      url: BASE_URL + path,\n      method,\n      headers: { Authorization: 'Bearer ' + API_TOKEN, ...(key ? { 'Idempotency-Key': key } : {}) },\n      ...(data === undefined ? {} : { data, encoding: 'json' }),\n    })\n    const body = response.responseData\n    if (!response.success || response.statusCode >= 400) {\n      const error = new Error(\n        body?.error?.message ||\n          response.error ||\n          'Gateway request could not be confirmed. Keep this note and use Get.',\n      )\n      error.detail = body\n      throw error\n    }\n    if (!body || typeof body !== 'object')\n      throw new Error('The gateway returned an invalid result. Keep this note and use Get.')\n    return body\n  }\n  function readDocument() {\n    const match = originalContent.match(HEADER)\n    if (!match) {\n      const lines = originalContent\n        .trim()\n        .split('\\n')\n        .filter((line) => line.trim())\n      const legacyList =\n        lines.length > 0 &&\n        lines.every((line) =>\n          /^- \\[[ xX]\\].*<!-- chatgptbox-conversation:[A-Za-z0-9-]+ -->\\s*$/.test(line),\n        )\n      if (/^<!-- chatgptbox-document:/.test(originalContent) || legacyList)\n        throw new Error(\n          'Use the matching ChatGPT actions for an old ChatGPT note. Gemini actions preserve it unchanged.',\n        )\n      return {\n        meta: { version: 3, engineId: ENGINE, id: identifier(), kind: 'new' },\n        body: originalContent,\n      }\n    }\n    let meta\n    try {\n      meta = JSON.parse(match[1])\n    } catch {\n      throw new Error('Damaged ChatGPTBox document header. The complete note was kept.')\n    }\n    if (\n      meta.version !== 3 ||\n      meta.engineId !== ENGINE ||\n      !/^[a-z0-9]{16,80}$/.test(meta.id) ||\n      !['new', 'list', 'conversation'].includes(meta.kind)\n    )\n      throw new Error(\n        'This is not a supported Gemini document. Use its matching actions; the complete note was kept.',\n      )\n    return { meta, body: originalContent.slice(match[0].length) }\n  }\n  function marker(meta, name) {\n    return '<!-- chatgptbox-' + meta.id + '-' + name + ' -->'\n  }\n  // An accidental-edit checksum, not an authentication or secrecy boundary.\n  function checksum(text) {\n    let first = 2166136261,\n      second = 3339675911\n    for (let index = 0; index < text.length; index++) {\n      const code = text.charCodeAt(index)\n      first = Math.imul(first ^ code, 16777619)\n      second = Math.imul(second ^ code, 2246822519)\n    }\n    return text.length + ':' + (first >>> 0).toString(16) + ':' + (second >>> 0).toString(16)\n  }\n  function pendingText(pending) {\n    return (\n      '## USER\\n\\n' +\n      userText(pending.query) +\n      '\\n\\n## ASSISTANT (pending)\\n\\nUse ' +\n      (pending.hintVersion === 1 ? 'Get' : 'Gemini Get') +\n      ' to collect this exact request.'\n    )\n  }\n  function span(meta, body, name) {\n    const start = marker(meta, name + ':start'),\n      end = marker(meta, name + ':end')\n    if (\n      body.split(start).length !== 2 ||\n      body.split(end).length !== 2 ||\n      body.indexOf(end) < body.indexOf(start)\n    )\n      throw new Error(\n        'Damaged or duplicate Gemini controls. The complete note and original request were kept.',\n      )\n    return {\n      start,\n      end,\n      from: body.indexOf(start) + start.length,\n      to: body.indexOf(end),\n      text: body\n        .slice(body.indexOf(start) + start.length, body.indexOf(end))\n        .replace(/^\\n|\\n$/g, ''),\n    }\n  }\n  function validate(meta, body) {\n    if (meta.kind !== 'conversation') return\n    span(meta, body, 'waiting')\n    span(meta, body, 'history')\n    if (meta.pending) {\n      if (\n        !/^drafts-[a-z0-9]+-[a-z0-9]+$/.test(meta.pending.key) ||\n        !meta.pending.request ||\n        typeof meta.pending.query !== 'string'\n      )\n        throw new Error('The original Gemini request is missing. Keep this note for inspection.')\n      if (span(meta, body, 'pending').text !== pendingText(meta.pending))\n        throw new Error(\n          'The pending text was edited. Keep the complete note and restore that generated block before Get; put new text in Waiting Reply or outside the history block.',\n        )\n    } else if (['pending:start', 'pending:end'].some((name) => body.includes(marker(meta, name))))\n      throw new Error('Conflicting Gemini pending controls. The complete note was kept.')\n  }\n  function assertManagedText(meta, body) {\n    if (\n      meta.kind === 'conversation' &&\n      meta.historyChecksum !== checksum(span(meta, body, 'history').text)\n    )\n      throw new Error(\n        'The generated history was edited. The complete note was kept. Move your notes outside its history markers, or use List/Get in a new note before refreshing.',\n      )\n  }\n  function save(meta, body) {\n    validate(meta, body)\n    if (meta.kind === 'conversation')\n      meta.historyChecksum = checksum(span(meta, body, 'history').text)\n    draft.content = '<!-- chatgptbox-document:' + encode(meta) + ' -->\\n' + body\n    draft.update()\n  }\n  function waitingBlock(meta, value = '') {\n    return (\n      '\\n\\n## Waiting Reply\\n' +\n      marker(meta, 'waiting:start') +\n      '\\n' +\n      value +\n      '\\n' +\n      marker(meta, 'waiting:end') +\n      '\\n'\n    )\n  }\n  function transcript(detail) {\n    if (!Array.isArray(detail.messages))\n      throw new Error('Gemini returned no readable conversation messages.')\n    return detail.messages\n      .map((message) =>\n        message.role === 'user'\n          ? '## USER\\n\\n' + userText(message.content)\n          : '## ASSISTANT' +\n            (message.completed ? '' : ' (incomplete)') +\n            '\\n\\n' +\n            (message.supported === false\n              ? 'This native content is not supported. Inspect the original Gemini conversation.'\n              : message.content || 'No confirmed final text is available.'),\n      )\n      .join('\\n\\n')\n  }\n  function detailFor(meta, cursor) {\n    let ref = meta.conversationRef\n    if (!ref) {\n      if (!meta.nativeConversationId)\n        throw new Error(\n          'No native conversation identity is available. Keep this note and inspect its original run.',\n        )\n      const page = request(\n        '/engines/' +\n          ENGINE +\n          '/conversations?conversationId=' +\n          encodeURIComponent(meta.nativeConversationId),\n      )\n      const matches = page.items?.filter((item) => item.id === meta.nativeConversationId)\n      if (matches?.length !== 1 || !matches[0].conversationRef)\n        throw new Error('The original native Gemini conversation could not be identified.')\n      ref = matches[0].conversationRef\n    }\n    return request(\n      '/engines/' +\n        ENGINE +\n        '/conversations/' +\n        encodeURIComponent(ref) +\n        '?limit=' +\n        HISTORY_PAGE_SIZE +\n        (cursor ? '&cursor=' + encodeURIComponent(cursor) : ''),\n    )\n  }\n  function list(meta, body) {\n    if (meta.kind === 'conversation')\n      throw new Error(\n        'Run List in a new note; this conversation and any waiting request were kept.',\n      )\n    const continuing = meta.kind === 'list' && !!meta.nextCursor\n    const page = request(\n      '/engines/' +\n        ENGINE +\n        '/conversations?limit=50' +\n        (continuing ? '&cursor=' + encodeURIComponent(meta.nextCursor) : ''),\n    )\n    if (!Array.isArray(page.items))\n      throw new Error('The gateway returned an invalid conversation list.')\n    const items = continuing ? [...(meta.items || [])] : []\n    for (const item of page.items) {\n      if (typeof item.conversationRef !== 'string' || !/^[A-Za-z0-9-]+$/.test(item.conversationRef))\n        throw new Error('Invalid conversation reference.')\n      if (!items.some((old) => old.ref === item.conversationRef))\n        items.push({ ref: item.conversationRef, title: safeTitle(item.title) })\n    }\n    if (items.length > 1000)\n      throw new Error(\n        'This list reached 1,000 conversations. Keep it and open another note for further browsing.',\n      )\n    const next = {\n      version: 3,\n      engineId: ENGINE,\n      id: meta.kind === 'list' ? meta.id : identifier(),\n      kind: 'list',\n      items,\n      nextCursor: page.nextCursor || null,\n    }\n    const rows = items.map(\n      (item) =>\n        '- [ ] ' +\n        item.title +\n        ' <!-- chatgptbox-' +\n        next.id +\n        '-conversation:' +\n        item.ref +\n        ' -->',\n    )\n    save(\n      next,\n      '# Gemini conversations\\n\\n' +\n        (next.nextCursor ? 'Run List again to load more. ' : '') +\n        'Check one conversation, then run Get.\\n\\n' +\n        rows.join('\\n') +\n        '\\n',\n    )\n    void body\n  }\n  function historyBlock(meta, content) {\n    return marker(meta, 'history:start') + '\\n' + content + '\\n' + marker(meta, 'history:end')\n  }\n  function unsent(meta, body, pending, message) {\n    const current = span(meta, body, 'pending')\n    body =\n      body.slice(0, body.indexOf(current.start)) +\n      '## Unsent request\\n\\n' +\n      userText(pending.query) +\n      '\\n\\n' +\n      userText(message) +\n      body.slice(current.to + current.end.length)\n    meta.lastUnsent = { key: pending.key, message }\n    delete meta.pending\n    save(meta, body)\n  }\n  function get(meta, body, older = false) {\n    validate(meta, body)\n    if (meta.kind === 'list') {\n      const selected = []\n      const seen = new Set()\n      for (const line of body.split('\\n')) {\n        if (!line.includes('<!-- chatgptbox-' + meta.id + '-conversation:')) continue\n        const match = line.match(\n          /^- \\[([ xX])\\] .* <!-- chatgptbox-([a-z0-9]+)-conversation:([A-Za-z0-9-]+) -->$/,\n        )\n        if (\n          !match ||\n          match[2] !== meta.id ||\n          seen.has(match[3]) ||\n          !meta.items?.some((item) => item.ref === match[3])\n        )\n          throw new Error('Damaged Gemini list. Keep the complete note.')\n        seen.add(match[3])\n        if (match[1].toLowerCase() === 'x')\n          selected.push(meta.items.find((item) => item.ref === match[3]))\n      }\n      if (seen.size !== meta.items?.length || selected.length !== 1)\n        throw new Error('Check exactly one Gemini conversation, then run Get.')\n      meta = {\n        version: 3,\n        engineId: ENGINE,\n        id: identifier(),\n        kind: 'conversation',\n        title: selected[0].title,\n        conversationRef: selected[0].ref,\n      }\n      body = '# ' + meta.title + '\\n\\n' + historyBlock(meta, '') + waitingBlock(meta)\n    }\n    if (meta.kind !== 'conversation')\n      throw new Error('Use List/Get for history, or Send on an ordinary note starting with :g.')\n    if (older && meta.pending)\n      throw new Error('Collect the pending request with Get before loading older messages.')\n    if (meta.pending) {\n      const pending = meta.pending\n      if (!pending.runId) {\n        const operation = request('/operations/' + encodeURIComponent(pending.key))\n        pending.runId = operation.result?.runId || operation.operationId\n        if (!pending.runId)\n          throw new Error(\n            'Submission is still unconfirmed. The original request was kept; no resubmission occurred.',\n          )\n        save(meta, body)\n      }\n      let run = request('/runs/' + encodeURIComponent(pending.runId))\n      if (run.engineId !== ENGINE || run.runId !== pending.runId)\n        throw new Error(\n          'The returned run does not match this Gemini request. The original note was kept.',\n        )\n      if (!run.result && run.resultAvailability === 'recoverable' && run.phase === 'settled') {\n        run = request('/runs/' + encodeURIComponent(pending.runId) + '/recover', 'POST', {})\n        if (run.engineId !== ENGINE || run.runId !== pending.runId)\n          throw new Error(\n            'The recovered run does not match this Gemini request. The original note was kept.',\n          )\n      }\n      if (run.phase === 'settled' && run.outcome === 'completed' && run.result?.content) {\n        if (run.result.version !== 1 || !['safe-html', 'markdown'].includes(run.result.format))\n          throw new Error('Unsupported result format; the original run was kept.')\n        const current = span(meta, body, 'pending')\n        body =\n          body.slice(0, body.indexOf(current.start)) +\n          '## USER\\n\\n' +\n          userText(pending.query) +\n          '\\n\\n## ASSISTANT\\n\\n' +\n          run.result.content +\n          body.slice(current.to + current.end.length)\n        meta.conversationRef = run.conversationRef || null\n        meta.revision = run.conversationRevision || null\n        meta.nativeConversationId = run.result.metadata?.conversationId || meta.nativeConversationId\n        meta.serverHead = run.result.metadata?.serverTurnId || null\n        delete meta.pending\n        save(meta, body)\n        app.displaySuccessMessage('Gemini answer collected. Waiting Reply was preserved.')\n      } else if (run.phase === 'settled' && run.submission === 'not_attempted') {\n        unsent(meta, body, pending, run.error?.message || 'The request was not submitted.')\n        throw new Error(\n          'Gemini did not submit this request. Its text was retained above; edit Waiting Reply before another explicit Send.',\n        )\n      } else {\n        save(meta, body)\n        app.displaySuccessMessage(\n          'Still waiting or unconfirmed. Use Get again; no new question was sent.',\n        )\n      }\n      return\n    }\n    if (older && !meta.historyCursor) {\n      app.displaySuccessMessage('All available Gemini turns in this conversation have been loaded.')\n      return\n    }\n    const detail = detailFor(meta, older ? meta.historyCursor : undefined)\n    if (older && meta.serverHead && detail.serverHead !== meta.serverHead)\n      throw new Error(\n        'The native conversation changed. Use Get to refresh it before loading older turns.',\n      )\n    meta.conversationRef = detail.conversationRef\n    meta.revision = detail.conversationRevision\n    meta.nativeConversationId = detail.conversationId\n    meta.serverHead = detail.serverHead\n    meta.historyCursor = detail.nextCursor || null\n    if (older) {\n      const current = span(meta, body, 'history')\n      save(\n        meta,\n        body.slice(0, current.from) +\n          '\\n' +\n          transcript(detail) +\n          '\\n\\n' +\n          current.text +\n          '\\n' +\n          body.slice(current.to),\n      )\n    } else {\n      const current = span(meta, body, 'history')\n      save(\n        meta,\n        body.slice(0, current.from) + '\\n' + transcript(detail) + '\\n' + body.slice(current.to),\n      )\n    }\n    if (meta.historyCursor)\n      app.displaySuccessMessage('More historical turns are available with More → 加载更早消息.')\n  }\n  function send(meta, body) {\n    if (meta.kind === 'list')\n      throw new Error(\n        'Open the checked conversation with Get before sending. Lists are never submitted.',\n      )\n    validate(meta, body)\n    if (meta.pending) return get(meta, body)\n    const query = meta.kind === 'new' ? body.trim() : span(meta, body, 'waiting').text.trim()\n    if (!query) return get(meta, body)\n    if (query.length > 50000)\n      throw new Error('Gemini accepts up to 50,000 characters. The note was kept.')\n    const continuing =\n      meta.kind === 'conversation' && !!(meta.conversationRef || meta.nativeConversationId)\n    if (continuing && (!meta.conversationRef || !Number.isInteger(meta.revision))) {\n      const detail = detailFor(meta)\n      if (meta.serverHead && detail.serverHead !== meta.serverHead)\n        throw new Error('The native conversation changed. Use Get to inspect it before sending.')\n      meta.conversationRef = detail.conversationRef\n      meta.revision = detail.conversationRevision\n    }\n    const payload = {\n      contractVersion: 1,\n      operation: continuing ? 'conversation.append' : 'generation.start',\n      input: { prompt: query },\n    }\n    if (continuing)\n      payload.conversation = { ref: meta.conversationRef, expectedRevision: meta.revision }\n    const key = 'drafts-' + Date.now().toString(36) + '-' + identifier()\n    const pending = {\n      key,\n      query,\n      request: clone(payload),\n      createdAt: Date.now(),\n      runId: null,\n      hintVersion: 1,\n    }\n    if (meta.kind === 'new') {\n      meta.kind = 'conversation'\n      meta.title = 'Gemini conversation'\n      body = '# Gemini conversation\\n\\n' + historyBlock(meta, '') + waitingBlock(meta)\n    } else {\n      const current = span(meta, body, 'waiting')\n      body = body.slice(0, current.from) + '\\n\\n' + body.slice(current.to)\n    }\n    const insertionAt = span(meta, body, 'history').to\n    body =\n      body.slice(0, insertionAt) +\n      '\\n\\n' +\n      marker(meta, 'pending:start') +\n      '\\n' +\n      pendingText(pending) +\n      '\\n' +\n      marker(meta, 'pending:end') +\n      '\\n' +\n      body.slice(insertionAt)\n    meta.pending = pending\n    save(meta, body) // Complete original request is durable BEFORE the HTTP write.\n    try {\n      const receipt = request('/engines/' + ENGINE + '/runs', 'POST', pending.request, key)\n      if (receipt.engineId !== ENGINE || typeof receipt.runId !== 'string')\n        throw new Error('The run receipt was invalid. Keep the original request and use Get.')\n      pending.runId = receipt.runId\n      save(meta, body)\n      app.displaySuccessMessage(\n        'Gemini request registered. Use Get; registration is not a final answer.',\n      )\n    } catch (error) {\n      if (\n        error.detail?.error?.submission === 'not_attempted' ||\n        error.detail?.error?.dispatched === false\n      ) {\n        unsent(meta, body, pending, error.message)\n      }\n      throw error\n    }\n  }\n  try {\n    const { meta, body } = readDocument()\n    validate(meta, body)\n    assertManagedText(meta, body)\n    if (ACTION === 'list') list(meta, body)\n    else if (ACTION === 'get') get(meta, body)\n    else if (ACTION === 'send') send(meta, body)\n    else if (ACTION === 'older') get(meta, body, true)\n    else throw new Error('Unknown Gemini action.')\n  } catch (error) {\n    app.displayErrorMessage(error.message || String(error))\n    throw error\n  }\n}\nconst ENGINE_ADAPTERS = { chatgptweb: runChatGPT, geminiweb: runGemini }\n// Nonsecret preferences have one owner outside the replaceable action packages.\nconst SETTINGS_PATH = '/ChatGPTBox/settings.json'\nconst SETTINGS_STAGE_PATH = '/ChatGPTBox/settings.pending.json'\n\nfunction defaultPreferences() {\n  return { version: 1, baseUrl: null, modelOverride: null, includeThinking: false }\n}\n\nfunction settingsSnapshot(fm) {\n  const exists = fm.exists(SETTINGS_PATH)\n  if (fm.lastError)\n    throw new Error(\n      '无法读取共享设置。请确认 iCloud Drive 可用并下载 ChatGPTBox/settings.json 后重试。',\n    )\n  if (!exists) return null\n  const text = fm.readString(SETTINGS_PATH)\n  if (typeof text !== 'string')\n    throw new Error(\n      '无法读取共享设置。请先下载 iCloud Drive/Drafts/ChatGPTBox/settings.json 后重试。',\n    )\n  return text\n}\n\nfunction validatePreferences(value) {\n  if (\n    !value ||\n    Array.isArray(value) ||\n    value.version !== 1 ||\n    Object.keys(value).some(\n      (key) => !['version', 'baseUrl', 'modelOverride', 'includeThinking'].includes(key),\n    ) ||\n    (value.baseUrl !== null && typeof value.baseUrl !== 'string') ||\n    (value.modelOverride !== null && typeof value.modelOverride !== 'string') ||\n    typeof value.includeThinking !== 'boolean'\n  )\n    throw new Error('共享设置格式不受支持。请通过 More → 设置 检查或重新设置。')\n  const baseUrl = value.baseUrl?.trim().replace(/\\/+$/, '') || null\n  const modelOverride = value.modelOverride?.trim() || null\n  if (\n    baseUrl &&\n    (baseUrl.length > 2048 || !/^https?:\\/\\/[^/?#\\s@]+(?:\\/[^?#\\s]*)?$/i.test(baseUrl))\n  )\n    throw new Error('网关地址须为 http:// 或 https:// 地址，不能包含用户名、密码、查询参数或片段。')\n  if (modelOverride && (modelOverride.length > 200 || /\\s/.test(modelOverride)))\n    throw new Error('模型须填写不含空格的 model slug；留空即可跟随扩展或会话。')\n  return { version: 1, baseUrl, modelOverride, includeThinking: value.includeThinking }\n}\n\nfunction preferencesFromSnapshot(text) {\n  if (text === null) return defaultPreferences()\n  if (typeof text !== 'string')\n    throw new Error('无法读取共享设置。请确认 iCloud Drive 文件可用后重试。')\n  if (text.length > 16384) throw new Error('共享设置文件过大。请通过 More → 设置 检查或重新设置。')\n  let value\n  try {\n    value = JSON.parse(text)\n  } catch {\n    throw new Error('共享设置不是有效 JSON。请通过 More → 设置 检查或重新设置。')\n  }\n  return validatePreferences(value)\n}\n\nfunction readPreferences() {\n  const text = settingsSnapshot(FileManager.createCloud())\n  if (text === null)\n    throw new Error(\n      '此设备未找到共享设置。首次使用请先运行 More → 设置 并保存；若已在其他设备配置，请等待 iCloud Drive/Drafts/ChatGPTBox/settings.json 同步并下载后重试。当前笔记已保留，未发出请求。',\n    )\n  return preferencesFromSnapshot(text)\n}\n\nfunction savePreferences(value, original) {\n  const fm = FileManager.createCloud()\n  if (settingsSnapshot(fm) !== original)\n    throw new Error('共享设置已被其他操作修改。请重新打开 More → 设置 后再保存。')\n  if (!fm.exists('/ChatGPTBox') && !fm.createDirectory('ChatGPTBox', '/'))\n    throw new Error('无法创建共享设置目录。请确认 iCloud Drive 可写后重试。')\n  if (\n    !fm.writeJSON(SETTINGS_STAGE_PATH, value) ||\n    JSON.stringify(preferencesFromSnapshot(fm.readString(SETTINGS_STAGE_PATH))) !==\n      JSON.stringify(value)\n  )\n    throw new Error('共享设置暂存失败；未替换原设置。请确认 iCloud Drive 可写后重试。')\n  if (settingsSnapshot(fm) !== original)\n    throw new Error('共享设置已被其他操作修改。请重新打开 More → 设置 后再保存。')\n  if (!fm.moveItem(SETTINGS_STAGE_PATH, SETTINGS_PATH, true))\n    throw new Error('无法确认共享设置已保存。请重新打开 More → 设置 检查后重试。')\n  const saved = settingsSnapshot(fm)\n  if (saved === null || JSON.stringify(preferencesFromSnapshot(saved)) !== JSON.stringify(value))\n    throw new Error('无法确认共享设置已保存。请重新打开 More → 设置 检查后重试。')\n}\n\nfunction editPreferences() {\n  const original = settingsSnapshot(FileManager.createCloud())\n  let value\n  try {\n    value = preferencesFromSnapshot(original)\n  } catch (error) {\n    const recovery = Prompt.create()\n    recovery.title = 'ChatGPTBox 设置需要修复'\n    recovery.message =\n      error.message +\n      '\\n请先确认文件已完成同步。重新设置后，只有点击保存才会替换原设置；API token 和当前笔记不受影响。'\n    recovery.addButton('重新设置')\n    if (!recovery.show()) return\n    value = defaultPreferences()\n  }\n  let fields = {\n    baseUrl: value.baseUrl || '',\n    modelOverride: value.modelOverride || '',\n    includeThinking: value.includeThinking,\n  }\n  for (;;) {\n    const prompt = Prompt.create()\n    prompt.title = 'ChatGPTBox 设置'\n    prompt.message =\n      '所有动作共用。地址留空沿用共享凭据中的地址；模型留空跟随扩展或会话。\\n模型和思考显示仅用于 ChatGPT；显示思考不会改变思考强度。更换地址后，已有笔记仍绑定原网关。'\n    const textOptions = { autocapitalization: 'none', autocorrect: false }\n    prompt.addTextField('baseUrl', '网关地址（留空沿用原地址）', fields.baseUrl, {\n      ...textOptions,\n      keyboard: 'URL',\n    })\n    prompt.addTextField(\n      'modelOverride',\n      'ChatGPT 模型（留空自动）',\n      fields.modelOverride,\n      textOptions,\n    )\n    prompt.addSwitch('includeThinking', 'ChatGPT：显示思考内容', fields.includeThinking)\n    prompt.addButton('保存')\n    prompt.addButton('API token 设置说明')\n    if (!prompt.show()) return\n    fields = { ...prompt.fieldValues }\n    if (prompt.buttonPressed === 'API token 设置说明') {\n      const help = Prompt.create()\n      help.title = 'ChatGPTBox API token'\n      help.message =\n        '所有动作沿用 Drafts Settings → Credentials → ChatGPTBox Gateway。首次网络操作会询问地址和 API token。\\n更新 token 时，在该凭据项使用 Forget，再运行网络动作重新填写。此处保存的网关地址会优先使用。地址须能从每台设备访问；iPhone 的 127.0.0.1 指向 iPhone。'\n      help.addButton('返回设置')\n      help.show()\n      continue\n    }\n    if (prompt.buttonPressed !== '保存') throw new Error('未知设置操作。未保存设置。')\n    try {\n      value = validatePreferences({ version: 1, ...fields })\n    } catch (error) {\n      app.displayErrorMessage(error.message)\n      continue\n    }\n    savePreferences(value, original)\n    app.displaySuccessMessage('ChatGPTBox 设置已保存，所有动作将共用。')\n    return\n  }\n}\n// Engine aliases and operations have one owner. A new adapter must be registered\n// explicitly; an unknown prefix never falls back to another provider.\nconst ENGINE_ALIASES = { c: 'chatgptweb', g: 'geminiweb' }\nconst ENGINE_OPERATIONS = {\n  chatgptweb: ['list', 'get', 'send', 'photos', 'project'],\n  geminiweb: ['list', 'get', 'send', 'older'],\n}\nconst DOCUMENT_HEADER = /^<!-- chatgptbox-document:(\\{[^\\n]*\\}) -->\\n?/\n\nfunction selectEngine(original) {\n  const prefix = original.match(/^\\uFEFF?:([a-z][a-z0-9_-]*)(?:[ \\t]+|\\r?\\n|$)/i)\n  if (!prefix && /^\\uFEFF?:[a-z]/i.test(original))\n    throw new Error(\n      'Put a space or a line break after :c or :g. The note was kept; no request was sent.',\n    )\n  const alias = prefix?.[1].toLowerCase()\n  const selected =\n    alias && Object.prototype.hasOwnProperty.call(ENGINE_ALIASES, alias)\n      ? ENGINE_ALIASES[alias]\n      : null\n  if (prefix && !selected)\n    throw new Error(\n      'Unknown engine prefix. Use :c for ChatGPT or :g for Gemini. The note was kept.',\n    )\n  const content = prefix ? original.slice(prefix[0].length) : original\n  const header = content.match(DOCUMENT_HEADER)\n  let meta = null,\n    engineId = null,\n    legacyKind = null\n  if (header) {\n    try {\n      meta = JSON.parse(header[1])\n    } catch {\n      throw new Error('Damaged ChatGPTBox header. The complete note was kept.')\n    }\n    if (\n      !meta ||\n      !/^[a-z0-9]{16,80}$/.test(meta.id) ||\n      (meta.version === 2 &&\n        (!Array.isArray(meta.controls) || !['note', 'list', 'conversation'].includes(meta.kind))) ||\n      (meta.version === 3 && !['new', 'list', 'conversation'].includes(meta.kind))\n    )\n      throw new Error('Unsupported ChatGPTBox header. The complete note was kept.')\n    if (meta.version === 2 && (meta.engineId === undefined || meta.engineId === 'chatgptweb'))\n      engineId = 'chatgptweb'\n    else if (meta.version === 3 && meta.engineId === 'geminiweb') engineId = 'geminiweb'\n    else throw new Error('Unsupported engine binding. The complete note was kept.')\n  } else {\n    if (content.includes('<!-- chatgptbox-document:'))\n      throw new Error('The ChatGPTBox header is damaged or misplaced. The complete note was kept.')\n    // The original ChatGPT parser validates/migrates these old structures.\n    if (/<!-- chatgptbox-|^Conversation ID:\\s*[A-Za-z0-9-]+\\s*$/m.test(content)) {\n      engineId = 'chatgptweb'\n      const lines = content.trim().split('\\n')\n      if (\n        lines.every((line) =>\n          /^- \\[[ x]\\].*<!-- chatgptbox-conversation:[A-Za-z0-9-]+ -->\\s*$/.test(line),\n        )\n      )\n        legacyKind = 'list'\n      else if (\n        /<!-- chatgptbox-waiting-reply:start |^Conversation ID:\\s*[A-Za-z0-9-]+\\s*$/m.test(content)\n      )\n        legacyKind = 'conversation'\n    }\n  }\n  const bound = !!engineId\n  if (bound && selected && selected !== engineId)\n    throw new Error(\n      'This note is bound to ' +\n        (engineId === 'chatgptweb' ? 'ChatGPT' : 'Gemini') +\n        '. Its engine cannot change. Use a new note; the complete note was kept.',\n    )\n  return {\n    content,\n    meta,\n    kind: meta?.kind || legacyKind,\n    bound,\n    engineId: engineId || selected || ENGINE_ALIASES.c,\n  }\n}\n\nfunction checkOperation(route, operation) {\n  if (!ENGINE_OPERATIONS[route.engineId]?.includes(operation))\n    throw new Error(\n      (route.engineId === 'geminiweb' ? 'Gemini' : 'ChatGPT') +\n        ' does not support this operation. The note was kept.',\n    )\n  if (\n    operation === 'list' &&\n    ((route.bound && route.kind !== 'list') || (!route.bound && route.content.trim()))\n  )\n    throw new Error(\n      'Run List on an empty new note, optionally starting with :c or :g. This note and its text were kept.',\n    )\n  if (route.kind === 'list' && operation !== 'list' && operation !== 'get')\n    throw new Error('Use Get to open the checked conversation first. The list was kept.')\n  if (operation === 'project' && route.bound && route.kind !== 'note')\n    throw new Error(\n      'Choose a Project on a new note before its first send. This conversation keeps its engine and Project.',\n    )\n}\n\nfunction gatewaySettings() {\n  const preferences = readPreferences()\n  const credential = Credential.create(\n    'ChatGPTBox Gateway',\n    'Shared by all ChatGPTBox actions. More → 设置 takes precedence for the gateway URL. Otherwise this URL is used; leave it blank for http://127.0.0.1:18080. Use an address reachable from every synced device.',\n  )\n  credential.addURLField('baseUrl', 'Gateway URL')\n  credential.addPasswordField('apiToken', 'Gateway API token')\n  if (!credential.authorize()) return null\n  const baseUrl = (\n    preferences.baseUrl ||\n    credential.getValue('baseUrl') ||\n    'http://127.0.0.1:18080'\n  )\n    .trim()\n    .replace(/\\/+$/, '')\n  const apiToken = (credential.getValue('apiToken') || '').trim()\n  if (\n    !/^https?:\\/\\/[^/?#\\s@]+(?:\\/[^?#\\s]*)?$/i.test(baseUrl) ||\n    !apiToken ||\n    /[\\r\\n]/.test(apiToken)\n  )\n    throw new Error(\n      'Configure the gateway URL in More → 设置 and the API token in Drafts Settings → Credentials → ChatGPTBox Gateway. No request was sent.',\n    )\n  return { ...preferences, baseUrl, apiToken }\n}\n\nfunction bufferedDraft(originalDraft, route, settings) {\n  if (route.meta?.gatewayUrl && route.meta.gatewayUrl !== settings.baseUrl)\n    throw new Error(\n      'This note belongs to a different gateway URL. Restore its original gateway configuration; the note and request identity were kept.',\n    )\n  let content = route.content\n  return {\n    get content() {\n      return content\n    },\n    set content(value) {\n      content = value\n    },\n    update() {\n      const match = content.match(DOCUMENT_HEADER)\n      if (!match)\n        throw new Error(\n          'The action did not produce a bound ChatGPTBox note. The original note was kept.',\n        )\n      const meta = JSON.parse(match[1])\n      // v2 itself is the ChatGPT binding, preserving old parser compatibility.\n      if (\n        (route.engineId === 'chatgptweb' && meta.version !== 2) ||\n        (route.engineId === 'geminiweb' && (meta.version !== 3 || meta.engineId !== route.engineId))\n      )\n        throw new Error(\n          'The action returned a different engine binding. The original note was kept.',\n        )\n      meta.gatewayUrl = settings.baseUrl\n      const next =\n        '<!-- chatgptbox-document:' +\n        JSON.stringify(meta).replace(/</g, '\\\\u003c').replace(/>/g, '\\\\u003e') +\n        ' -->\\n' +\n        content.slice(match[0].length)\n      const previous = originalDraft.content\n      originalDraft.content = next\n      try {\n        const result = originalDraft.update()\n        if (result === false) throw new Error('Draft save failed. No further request was made.')\n        content = next\n        return result\n      } catch (error) {\n        originalDraft.content = previous\n        throw error\n      }\n    },\n  }\n}\n\nfunction moreOperation(route) {\n  const prompt = Prompt.create()\n  prompt.title = 'ChatGPTBox · ' + (route.engineId === 'geminiweb' ? 'Gemini' : 'ChatGPT')\n  const choices = []\n  if (!route.bound || ['note', 'new', 'conversation'].includes(route.kind)) {\n    if (route.engineId === 'chatgptweb') {\n      choices.push(['添加照片', 'photos'])\n      if (!route.bound || route.kind === 'note') choices.push(['选择 Project', 'project'])\n    } else if (route.kind === 'conversation' && !route.meta.pending)\n      choices.push(['加载更早消息', 'older'])\n  }\n  for (const [label] of choices) prompt.addButton(label)\n  prompt.addButton('设置')\n  prompt.message =\n    (route.engineId === 'geminiweb' ? 'Gemini 不支持照片或 Project。' : '') +\n    '新笔记首部用 :c 或 :g；省略时使用 ChatGPT。已有会话固定使用原引擎。'\n  if (!prompt.show()) return null\n  const selected = choices.find(([label]) => label === prompt.buttonPressed)\n  if (selected) return selected[1]\n  if (prompt.buttonPressed === '设置') return 'settings'\n  throw new Error('Unknown ChatGPTBox operation. No request was made.')\n}\n\nfunction runAction() {\n  const route = selectEngine(draft.content || '')\n  const operation = ACTION === 'more' ? moreOperation(route) : ACTION\n  if (!operation) return\n  if (operation === 'settings') return editPreferences()\n  checkOperation(route, operation)\n  const settings = gatewaySettings()\n  if (!settings) return\n  const input = bufferedDraft(draft, route, settings)\n  ENGINE_ADAPTERS[route.engineId](input, settings, operation)\n}\n\ntry {\n  runAction()\n} catch (error) {\n  app.displayErrorMessage(error.message || String(error))\n  throw error\n}\n",
        "allowAsync": "false"
      }
    }
  ],
  "shouldConfirm": false,
  "disposition": 0,
  "groupDisposition": 0,
  "logLevel": 1,
  "notificationType": 1,
  "tintColor": "green",
  "keyUseIcon": true,
  "icon": "action",
  "visibility": 480,
  "assignTags": []
}
