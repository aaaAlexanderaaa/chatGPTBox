{
  "uuid": "89E9B0C5-1DDC-4E61-A541-BF2C2B0E8D2D",
  "name": "ChatGPTBox Preview",
  "shortName": "Preview",
  "actionDescription": "Offline ChatGPTBox conversation preview with LaTeX math and local interactive charts.",
  "steps": [
    {
      "uuid": "49892222-6483-4DC2-927B-51AB0A3EF399",
      "type": "htmlpreview",
      "platforms": 3,
      "isEnabled": true,
      "data": {
        "template": "<!doctype html>\n<html lang=\"zh-CN\">\n  <head>\n    <meta charset=\"utf-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n    <meta name=\"color-scheme\" content=\"light dark\">\n    <meta http-equiv=\"Content-Security-Policy\" content=\"default-src 'none'; script-src 'sha256-6/spagzeowKY9PV2GhG3VWfJ5tkzUMr0IFMUzgexQZE='; style-src 'unsafe-inline'; img-src data:; base-uri 'none'; form-action 'none'\">\n    <title>ChatGPTBox</title>\n    <style>\n      :root {\n        color-scheme: light dark;\n        --page: #fff;\n        --ink: #1f2328;\n        --muted: #657080;\n        --line: #d8dee8;\n        --surface: #f5f7fa;\n        --link: #1765b5;\n      }\n      * { box-sizing: border-box; }\n      body {\n        margin: 0;\n        background: var(--page);\n        color: var(--ink);\n        font: 16px/1.65 -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;\n        overflow-wrap: anywhere;\n      }\n      main {\n        max-width: 960px;\n        margin: 0 auto;\n        padding: 28px 24px 72px;\n      }\n      h1, h2, h3, h4 { line-height: 1.35; }\n      h1 { font-size: 1.65rem; margin: 0 0 20px; }\n      h2 { font-size: 1.25rem; margin: 32px 0 16px; }\n      h3 { font-size: 1.1rem; margin: 24px 0 12px; }\n      main > h3 {\n        border-top: 1px solid var(--line);\n        padding-top: 20px;\n        color: var(--muted);\n        font-size: .9rem;\n      }\n      /* Keep gateway metadata in the editable note, outside the reading view. */\n      main > p:has(~ h2:first-of-type), main > h2:first-of-type { display: none; }\n      p, ul, ol { margin: 12px 0; }\n      li + li { margin-top: 8px; }\n      a { color: var(--link); text-underline-offset: 3px; }\n      a:focus-visible { outline: 2px solid var(--link); outline-offset: 3px; }\n      blockquote {\n        margin: 16px 0;\n        padding: 4px 16px;\n        border-left: 3px solid var(--line);\n        color: var(--muted);\n      }\n      pre {\n        padding: 16px;\n        overflow: auto;\n        background: var(--surface);\n        border-radius: 8px;\n      }\n      code { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: .9em; }\n      :not(pre) > code { background: var(--surface); padding: 2px 5px; border-radius: 4px; }\n      kbd {\n        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;\n        font-size: .85em;\n        padding: 1px 6px;\n        background: var(--surface);\n        border: 1px solid var(--line);\n        border-radius: 4px;\n      }\n      mark {\n        background: rgba(250, 204, 21, .35);\n        color: inherit;\n        padding: 0 3px;\n        border-radius: 3px;\n      }\n      del { color: var(--muted); }\n      sub, sup { font-size: .75em; line-height: 0; }\n      dl { margin: 16px 0; }\n      dt { font-weight: 600; margin-top: 12px; }\n      dd { margin: 4px 0 0 20px; }\n      details:not(.chatgptbox-genui-chart-fallback) {\n        margin: 14px 0;\n        padding: 10px 14px;\n        background: var(--surface);\n        border: 1px solid var(--line);\n        border-radius: 8px;\n      }\n      details:not(.chatgptbox-genui-chart-fallback) > summary {\n        cursor: pointer;\n        font-weight: 600;\n        color: var(--muted);\n      }\n      details:not(.chatgptbox-genui-chart-fallback)[open] > summary { margin-bottom: 10px; }\n      li > input[type=\"checkbox\"] {\n        margin: 0 6px 0 0;\n        vertical-align: middle;\n        accent-color: var(--link);\n      }\n      hr { border: 0; border-top: 1px solid var(--line); margin: 24px 0; }\n      img { max-width: 100%; height: auto; }\n      .chatgptbox-math-display {\n        display: block;\n        margin: 16px 0;\n        padding: 4px 0;\n        overflow-x: auto;\n        overflow-y: hidden;\n        text-align: center;\n      }\n      .chatgptbox-math-display > .katex { display: inline-block; }\n      math {\n        font-family: \"STIX Two Math\", \"Cambria Math\", \"Apple Symbols\", math, serif;\n        font-size: 1.05em;\n        line-height: 1.4;\n      }\n      .chatgptbox-math-display math { font-size: 1.12em; }\n      menclose[notation~=\"box\"] {\n        border: 1px solid currentColor;\n        padding: 2px 5px;\n        border-radius: 2px;\n      }\n      .chatgptbox-table-scroll { width: 100%; overflow-x: auto; margin: 16px 0; }\n      .chatgptbox-table-scroll > table { margin: 0; }\n      table {\n        width: 100%;\n        border-collapse: collapse;\n        margin: 16px 0;\n        font-size: .9rem;\n      }\n      th, td {\n        padding: 10px 12px;\n        border-bottom: 1px solid var(--line);\n        vertical-align: top;\n        text-align: left;\n      }\n      th { font-weight: 600; }\n      main > table { display: block; overflow-x: auto; }\n      /* chatgptbox-genui-styles:start */\n.chatgptbox-genui {\n  --chatgptbox-genui-surface: #f5f7fa;\n  --chatgptbox-genui-muted: #657080;\n  --chatgptbox-genui-line: #d8dee8;\n  container-type: inline-size;\n  line-height: 1.65;\n  overflow-wrap: anywhere;\n}\n.chatgptbox-genui-direction-row {\n  flex-direction: row;\n}\n.chatgptbox-genui-direction-column {\n  flex-direction: column;\n}\n.chatgptbox-genui-card,\n.chatgptbox-genui-col,\n.chatgptbox-genui-row,\n.chatgptbox-genui-grid-item,\n.chatgptbox-genui-flow-item {\n  display: flex;\n  flex-direction: column;\n  min-width: 0;\n}\n.chatgptbox-genui-row,\n.chatgptbox-genui-direction-row {\n  flex-direction: row;\n}\n.chatgptbox-genui-card {\n  margin: 12px 0;\n}\n.chatgptbox-genui-badge {\n  display: inline-block;\n  align-self: flex-start;\n  padding: 2px 8px;\n  background: var(--chatgptbox-genui-surface);\n  font-size: 0.85em;\n}\n.chatgptbox-genui-pill {\n  border-radius: 999px;\n}\n.chatgptbox-genui-spacer {\n  flex: 1;\n}\n.chatgptbox-genui-inline {\n  display: inline;\n  margin: 0;\n}\n.chatgptbox-genui-preserve-whitespace {\n  white-space: pre-wrap;\n}\n.chatgptbox-genui-italic {\n  font-style: italic;\n}\n.chatgptbox-genui-underline {\n  text-decoration: underline;\n}\n.chatgptbox-genui-strikethrough {\n  text-decoration: line-through;\n}\n.chatgptbox-genui-weight-medium {\n  font-weight: 500;\n}\n.chatgptbox-genui-weight-semibold {\n  font-weight: 600;\n}\n.chatgptbox-genui-weight-bold {\n  font-weight: 700;\n}\n.chatgptbox-genui-textAlign-left,\n.chatgptbox-genui-table-cell.chatgptbox-genui-align-left {\n  text-align: left;\n}\n.chatgptbox-genui-textAlign-right,\n.chatgptbox-genui-table-cell.chatgptbox-genui-align-right {\n  text-align: right;\n}\n.chatgptbox-genui-textAlign-center,\n.chatgptbox-genui-table-cell.chatgptbox-genui-align-center {\n  text-align: center;\n}\n.chatgptbox-genui-textAlign-start {\n  text-align: start;\n}\n.chatgptbox-genui-textAlign-end {\n  text-align: end;\n}\n.chatgptbox-genui-vAlign-center {\n  vertical-align: middle;\n}\n.chatgptbox-genui-vAlign-end {\n  vertical-align: bottom;\n}\n.chatgptbox-genui-color-secondary,\n.chatgptbox-genui-color-tertiary {\n  color: var(--chatgptbox-genui-muted) !important;\n}\n.chatgptbox-genui-list-none {\n  list-style: none;\n  padding-left: 0;\n}\n.chatgptbox-genui-blockquote {\n  padding: 4px 16px;\n  border-left: 3px solid var(--chatgptbox-genui-line);\n  margin: 12px 0;\n}\n.chatgptbox-genui-code-block {\n  padding: 16px;\n  overflow-x: auto;\n  background: var(--chatgptbox-genui-surface);\n  border-radius: 8px;\n}\n.chatgptbox-genui-code,\n.chatgptbox-genui-code-block code {\n  white-space: pre-wrap;\n  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;\n}\n.chatgptbox-genui-writing-block,\n.chatgptbox-genui-link-card {\n  display: block;\n  padding: 16px;\n  margin: 12px 0;\n  border: 1px solid var(--chatgptbox-genui-line);\n  border-radius: 8px;\n}\n.chatgptbox-genui-link-card {\n  text-decoration: none;\n}\n.chatgptbox-genui-background-secondary {\n  background-color: var(--chatgptbox-genui-surface);\n}\n.chatgptbox-genui-color-success {\n  color: #09866d;\n}\n.chatgptbox-genui-color-warning {\n  color: #b45309;\n}\n.chatgptbox-genui-color-danger {\n  color: #b91c1c;\n}\n.chatgptbox-genui-grid-item {\n  min-width: 0;\n}\n.chatgptbox-genui-list {\n  padding-left: 24px;\n}\n.chatgptbox-genui-text {\n  margin: 8px 0;\n}\n.chatgptbox-genui-caption {\n  font-size: 12px;\n  color: var(--chatgptbox-genui-muted);\n}\n.chatgptbox-genui-title {\n  margin: 4px 0;\n  line-height: 1.25;\n}\n.chatgptbox-genui-grid,\n.chatgptbox-genui-flow {\n  display: grid;\n  margin: 16px 0;\n}\n.chatgptbox-genui-box {\n  display: flex;\n  flex-direction: column;\n  min-width: 0;\n}\n.chatgptbox-genui-row {\n  display: flex;\n  flex-wrap: wrap;\n}\n.chatgptbox-genui-border {\n  border: 1px solid var(--chatgptbox-genui-line) !important;\n}\n.chatgptbox-genui-radius-sm {\n  border-radius: 4px;\n}\n.chatgptbox-genui-radius-md {\n  border-radius: 8px;\n}\n.chatgptbox-genui-radius-lg {\n  border-radius: 12px;\n}\n.chatgptbox-genui-size-2xs {\n  font-size: 11px;\n}\n.chatgptbox-genui-size-xs {\n  font-size: 12px;\n}\n.chatgptbox-genui-size-sm {\n  font-size: 14px;\n}\n.chatgptbox-genui-size-md {\n  font-size: 16px;\n}\n.chatgptbox-genui-size-lg {\n  font-size: 20px;\n}\n.chatgptbox-genui-size-xl {\n  font-size: 24px;\n}\n.chatgptbox-genui-size-2xl {\n  font-size: 30px;\n}\n.chatgptbox-genui-weight-medium {\n  font-weight: 500;\n}\n.chatgptbox-genui-weight-semibold {\n  font-weight: 600;\n}\n.chatgptbox-genui-weight-bold {\n  font-weight: 700;\n}\n.chatgptbox-genui-color-secondary {\n  color: #657080;\n}\n.chatgptbox-genui-color-tertiary {\n  color: #788496;\n}\n.chatgptbox-genui-tabular {\n  font-variant-numeric: tabular-nums;\n}\n.chatgptbox-genui-flex {\n  flex: 1;\n}\n.chatgptbox-genui-align-center {\n  align-items: center;\n}\n.chatgptbox-genui-align-start {\n  align-items: flex-start;\n}\n.chatgptbox-genui-align-end {\n  align-items: flex-end;\n}\n.chatgptbox-genui-justify-between {\n  justify-content: space-between;\n}\n.chatgptbox-genui-justify-center {\n  justify-content: center;\n}\n.chatgptbox-genui-justify-start {\n  justify-content: flex-start;\n}\n.chatgptbox-genui-columns-1 {\n  grid-template-columns: minmax(0, 1fr);\n}\n.chatgptbox-genui-columns-2 {\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n}\n.chatgptbox-genui-columns-3 {\n  grid-template-columns: repeat(3, minmax(0, 1fr));\n}\n.chatgptbox-genui-columns-4 {\n  grid-template-columns: repeat(4, minmax(0, 1fr));\n}\n.chatgptbox-genui-columns-5 {\n  grid-template-columns: repeat(5, minmax(0, 1fr));\n}\n.chatgptbox-genui-columns-6 {\n  grid-template-columns: repeat(6, minmax(0, 1fr));\n}\n.chatgptbox-genui-gap-0 {\n  gap: 0;\n}\n.chatgptbox-genui-gap-1 {\n  gap: 4px;\n}\n.chatgptbox-genui-gap-2 {\n  gap: 8px;\n}\n.chatgptbox-genui-gap-3 {\n  gap: 12px;\n}\n.chatgptbox-genui-gap-4 {\n  gap: 16px;\n}\n.chatgptbox-genui-padding-0 {\n  padding: 0;\n}\n.chatgptbox-genui-padding-1 {\n  padding: 4px;\n}\n.chatgptbox-genui-padding-2 {\n  padding: 8px;\n}\n.chatgptbox-genui-padding-3 {\n  padding: 12px;\n}\n.chatgptbox-genui-padding-4 {\n  padding: 16px;\n}\n.chatgptbox-genui-table {\n  width: 100%;\n  min-width: 540px;\n  border-collapse: collapse;\n  margin: 16px 0;\n}\n.chatgptbox-genui-table-scroll {\n  max-width: 100%;\n  overflow-x: auto;\n}\n.chatgptbox-genui-table-cell {\n  padding: 12px;\n  border-bottom: 1px solid var(--chatgptbox-genui-line);\n  vertical-align: top;\n}\n.chatgptbox-genui-table th {\n  text-align: left;\n  font-weight: 600;\n}\n@container (max-width: 420px) {\n  .chatgptbox-genui-grid,\n  .chatgptbox-genui-flow {\n    grid-template-columns: minmax(0, 1fr) !important;\n  }\n  .chatgptbox-genui-grid > .chatgptbox-genui-grid-item,\n  .chatgptbox-genui-flow > .chatgptbox-genui-flow-item {\n    grid-column: auto !important;\n    grid-row: auto !important;\n  }\n}\n\n.chatgptbox-genui-box.chatgptbox-genui-direction-row,\n.chatgptbox-genui-card.chatgptbox-genui-direction-row,\n.chatgptbox-genui-col.chatgptbox-genui-direction-row,\n.chatgptbox-genui-grid-item.chatgptbox-genui-direction-row,\n.chatgptbox-genui-flow-item.chatgptbox-genui-direction-row {\n  flex-direction: row;\n}\n.chatgptbox-genui-text.chatgptbox-genui-inline {\n  display: inline;\n  margin: 0;\n}\n.chatgptbox-genui-grid.chatgptbox-genui-auto-columns {\n  grid-template-columns: repeat(\n    auto-fit,\n    minmax(min(var(--chatgptbox-genui-min-child-width), 100%), 1fr)\n  );\n}\n.chatgptbox-genui-table-equal table {\n  table-layout: fixed;\n}\n.chatgptbox-genui-align-stretch {\n  align-items: stretch;\n}\n.chatgptbox-genui-justify-end {\n  justify-content: flex-end;\n}\n@media (prefers-color-scheme: dark) {\n  .chatgptbox-genui {\n    --chatgptbox-genui-surface: #242b35;\n    --chatgptbox-genui-muted: #a3aebb;\n    --chatgptbox-genui-line: #3c4653;\n  }\n  .chatgptbox-genui-color-success {\n    color: #62cfb4 !important;\n  }\n  .chatgptbox-genui-color-warning {\n    color: #f6bb68 !important;\n  }\n  .chatgptbox-genui-color-danger {\n    color: #ff9c9c !important;\n  }\n}\n\n[data-theme='dark'] .chatgptbox-genui {\n  --chatgptbox-genui-surface: #242b35;\n  --chatgptbox-genui-muted: #a3aebb;\n  --chatgptbox-genui-line: #3c4653;\n}\n[data-theme='light'] .chatgptbox-genui {\n  --chatgptbox-genui-surface: #f5f7fa;\n  --chatgptbox-genui-muted: #657080;\n  --chatgptbox-genui-line: #d8dee8;\n}\n[data-theme='dark'] .chatgptbox-genui-color-success {\n  color: #62cfb4 !important;\n}\n[data-theme='dark'] .chatgptbox-genui-color-warning {\n  color: #f6bb68 !important;\n}\n[data-theme='dark'] .chatgptbox-genui-color-danger {\n  color: #ff9c9c !important;\n}\n[data-theme='light'] .chatgptbox-genui-color-success {\n  color: #09866d !important;\n}\n[data-theme='light'] .chatgptbox-genui-color-warning {\n  color: #b45309 !important;\n}\n[data-theme='light'] .chatgptbox-genui-color-danger {\n  color: #b91c1c !important;\n}\n\n.chatgptbox-genui-gap-5 {\n  gap: 20px;\n}\n.chatgptbox-genui-padding-5 {\n  padding: 20px;\n}\n\n.chatgptbox-genui-gap-6 {\n  gap: 24px;\n}\n.chatgptbox-genui-padding-6 {\n  padding: 24px;\n}\n\n.chatgptbox-genui-gap-7 {\n  gap: 28px;\n}\n.chatgptbox-genui-padding-7 {\n  padding: 28px;\n}\n\n.chatgptbox-genui-gap-8 {\n  gap: 32px;\n}\n.chatgptbox-genui-padding-8 {\n  padding: 32px;\n}\n\n.chatgptbox-genui-gap-9 {\n  gap: 36px;\n}\n.chatgptbox-genui-padding-9 {\n  padding: 36px;\n}\n\n.chatgptbox-genui-gap-10 {\n  gap: 40px;\n}\n.chatgptbox-genui-padding-10 {\n  padding: 40px;\n}\n\n.chatgptbox-genui-gap-11 {\n  gap: 44px;\n}\n.chatgptbox-genui-padding-11 {\n  padding: 44px;\n}\n\n.chatgptbox-genui-gap-12 {\n  gap: 48px;\n}\n.chatgptbox-genui-padding-12 {\n  padding: 48px;\n}\n\n.chatgptbox-genui-columnGap-0 {\n  column-gap: 0px;\n}\n\n.chatgptbox-genui-columnGap-1 {\n  column-gap: 4px;\n}\n\n.chatgptbox-genui-columnGap-2 {\n  column-gap: 8px;\n}\n\n.chatgptbox-genui-columnGap-3 {\n  column-gap: 12px;\n}\n\n.chatgptbox-genui-columnGap-4 {\n  column-gap: 16px;\n}\n\n.chatgptbox-genui-columnGap-5 {\n  column-gap: 20px;\n}\n\n.chatgptbox-genui-columnGap-6 {\n  column-gap: 24px;\n}\n\n.chatgptbox-genui-columnGap-7 {\n  column-gap: 28px;\n}\n\n.chatgptbox-genui-columnGap-8 {\n  column-gap: 32px;\n}\n\n.chatgptbox-genui-columnGap-9 {\n  column-gap: 36px;\n}\n\n.chatgptbox-genui-columnGap-10 {\n  column-gap: 40px;\n}\n\n.chatgptbox-genui-columnGap-11 {\n  column-gap: 44px;\n}\n\n.chatgptbox-genui-columnGap-12 {\n  column-gap: 48px;\n}\n\n.chatgptbox-genui-rowGap-0 {\n  row-gap: 0px;\n}\n\n.chatgptbox-genui-rowGap-1 {\n  row-gap: 4px;\n}\n\n.chatgptbox-genui-rowGap-2 {\n  row-gap: 8px;\n}\n\n.chatgptbox-genui-rowGap-3 {\n  row-gap: 12px;\n}\n\n.chatgptbox-genui-rowGap-4 {\n  row-gap: 16px;\n}\n\n.chatgptbox-genui-rowGap-5 {\n  row-gap: 20px;\n}\n\n.chatgptbox-genui-rowGap-6 {\n  row-gap: 24px;\n}\n\n.chatgptbox-genui-rowGap-7 {\n  row-gap: 28px;\n}\n\n.chatgptbox-genui-rowGap-8 {\n  row-gap: 32px;\n}\n\n.chatgptbox-genui-rowGap-9 {\n  row-gap: 36px;\n}\n\n.chatgptbox-genui-rowGap-10 {\n  row-gap: 40px;\n}\n\n.chatgptbox-genui-rowGap-11 {\n  row-gap: 44px;\n}\n\n.chatgptbox-genui-rowGap-12 {\n  row-gap: 48px;\n}\n.chatgptbox-genui-chart {\n  min-width: 0;\n  margin: 16px 0;\n}\n.chatgptbox-genui-widget-source {\n  min-width: 0;\n  max-width: 100%;\n}\n.chatgptbox-genui-chart-viewport {\n  display: none;\n  width: 100%;\n  overflow: hidden;\n}\n.chatgptbox-genui-chart-ready > .chatgptbox-genui-chart-viewport {\n  display: block;\n}\n.chatgptbox-genui-chart-data > summary {\n  cursor: pointer;\n  color: var(--chatgptbox-genui-muted, #657080);\n  padding: 8px 0;\n}\n.chatgptbox-genui-chart-data td:not(:first-child),\n.chatgptbox-genui-chart-data th:not(:first-child) {\n  text-align: right;\n}\n      /* chatgptbox-genui-styles:end */\n      .chatgptbox-genui-table-cell > .chatgptbox-genui-text { margin: 0; }\n      @media (max-width: 480px) {\n        main { padding: 20px 16px 48px; }\n        h1 { font-size: 1.4rem; }\n      }\n      @media (prefers-color-scheme: dark) {\n        :root {\n          --page: #15191e;\n          --ink: #e8edf2;\n          --muted: #a3aebb;\n          --line: #3c4653;\n          --surface: #242b35;\n          --link: #83baff;\n        }\n        mark { background: rgba(250, 204, 21, .28); }\n      }\n      @media print {\n        :root { --page: #fff; --ink: #111; --muted: #555; --line: #ddd; --surface: #f5f5f5; }\n        main { max-width: none; padding: 0; }\n        a { color: inherit; }\n        .chatgptbox-genui-table-scroll, .chatgptbox-table-scroll, .chatgptbox-math-display, main > table { overflow: visible; }\n        .chatgptbox-genui-table { min-width: 0; }\n        tr, .chatgptbox-genui-box, .chatgptbox-math-display { break-inside: avoid; }\n      }\n    </style>\n  </head>\n  <body>\n    <main>%%[[draft]]%%</main>\n  <script>/* Bundled third-party notices and licenses\nApache ECharts\nCopyright 2017-2026 The Apache Software Foundation\n\nThis product includes software developed at\nThe Apache Software Foundation (https://www.